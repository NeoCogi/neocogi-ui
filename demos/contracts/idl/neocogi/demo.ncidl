extern neocogi.ui.core;
use neocogi.ui.core::{IRenderItem, IWidget, ILeafLayout, IActivationEvents, IWidgetHost, IContainer, ChildEditResult};

/// Copied two-component floating-point vector with no external Rust layout dependency.
#[version(1)]
struct Vector2 {
    /// First component.
    x: f32,
    /// Second component.
    y: f32,
}

/// Copied three-component floating-point vector with no external Rust layout dependency.
#[version(1)]
struct Vector3 {
    /// First component.
    x: f32,
    /// Second component.
    y: f32,
    /// Third component.
    z: f32,
}

/// Column-major four-by-four floating-point matrix copied across the demo ABI.
#[version(1)]
struct Matrix4 {
    /// Column zero, row zero.
    m00: f32,
    /// Column zero, row one.
    m01: f32,
    /// Column zero, row two.
    m02: f32,
    /// Column zero, row three.
    m03: f32,
    /// Column one, row zero.
    m10: f32,
    /// Column one, row one.
    m11: f32,
    /// Column one, row two.
    m12: f32,
    /// Column one, row three.
    m13: f32,
    /// Column two, row zero.
    m20: f32,
    /// Column two, row one.
    m21: f32,
    /// Column two, row two.
    m22: f32,
    /// Column two, row three.
    m23: f32,
    /// Column three, row zero.
    m30: f32,
    /// Column three, row one.
    m31: f32,
    /// Column three, row two.
    m32: f32,
    /// Column three, row three.
    m33: f32,
}

#[version(1)]
/// Plain vertex format shared by all native demo shaders.
struct MeshVertex {
    /// Object-space position; every component must be finite.
    position: Vector3,
    /// Object-space normal; every component must be finite.
    normal: Vector3,
    /// Procedural material coordinates; every component must be finite.
    uv: Vector2,
}

#[version(1)]
/// Column-major scene transforms, copied atomically as one camera/model update.
struct SceneTransforms {
    /// Projection-view-model transform applied to mesh positions.
    pvm: Matrix4,
    /// View-model transform applied to normals, matching the existing demo's shader convention.
    view_model: Matrix4,
}

#[version(1)]
/// Editable mesh scene is itself a render item on one COM allocation.
trait IMeshScene: IRenderItem {
    /// Replaces the complete immutable mesh after validating finite vertices and in-range triangle indices.
    /// Offsets must be zero; limits are 4M vertices and 12M indices. Two empty buffers clear the mesh.
    fn set_mesh(&self, vertices: &[MeshVertex], indices: &[u32]) -> Result<()>;
    /// Replaces both finite matrices together; scene edits affect subsequent render preparation only.
    fn set_transforms(&self, transforms: SceneTransforms) -> Result<()>;
}

#[version(1)]
/// Demo-specific factory exposed by the native window alongside its ordinary renderer interfaces.
trait IDemoScenes {
    /// Creates an empty scene with identity transforms; its resources retain this window/device.
    fn create_scene(&self) -> Result<IMeshScene>;
}

#[version(1)]
/// Observable phase attempts on one example widget, without exposing its native state.
struct WidgetCalls {
    /// Preferred-size queries that reached the widget's algorithm.
    measures: u64,
    /// Placement queries that reached the container's algorithm.
    placements: u64,
    /// Routed or eventless update attempts.
    updates: u64,
    /// Paint attempts, including a failed outward painter call.
    paints: u64,
    /// Committed logical closures; final COM release is a separate lifetime event.
    closes: u64,
}

#[version(1)]
/// Example diagnostics remain readable after logical closure for lifetime assertions.
trait IWidgetProbe {
    /// Returns counts from the actual allocation, with no callback or copied semantic model.
    fn calls(&self) -> Result<WidgetCalls>;
}

#[version(1)]
/// A custom control created only through ExtensionProvider whose shared widget capabilities remain queryable.
class Counter: IWidget + ILeafLayout + IActivationEvents + IWidgetProbe {

    /// Reads the actual current activation count.
    fn count(&self) -> Result<u32>;

    /// Silently replaces the displayed count and invalidates its preferred text size when changed.
    fn set_count(&mut self, value: u32) -> Result<()>;
}

#[version(1)]
/// A one-child container demonstrates a domain-specific layout policy over the shared child editor.
trait IInset: IContainer {
    /// Installs or replaces its one child; removed-child teardown uses the ordinary committed outcome.
    fn set_child(&mut self, child: &IWidget) -> Result<ChildEditResult>;
    /// Sets a nonnegative inset, bounded to avoid arithmetic overflow in doubled extents.
    fn set_padding(&mut self, padding: i32) -> Result<()>;
}

#[version(1)]
/// Stateless plugin factory receiving runtime authority explicitly for each custom object.
factory ExtensionProvider {
    /// Creates a counter whose complete state belongs to the returned COM identity.
    fn counter(&self, host: &IWidgetHost) -> Result<Counter>;
    /// Creates an empty custom container; child attachment follows the same rules as built-ins.
    fn inset(&self, host: &IWidgetHost) -> Result<IInset>;
}
