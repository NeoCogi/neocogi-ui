#[version(1)]
/// Checked contiguous range in a bundle's name bytes or glyph records.
struct AssetRange {
    /// First byte or record; arithmetic is checked before indexing.
    first: u32,
    /// Number of bytes or records, without a terminator.
    count: u32,
}

#[version(1)]
/// Allocation bounds read before copying any variable-length table.
struct AssetInfo {
    /// Exact ASSET_SCHEMA_VERSION; reject stale semantic table layouts before allocation.
    schema: u32,
    /// Positive atlas dimensions, with exactly width * height * 4 RGBA bytes.
    size: Size,
    /// Number of font records; fonts plus icons must not exceed MAX_ASSETS (16384).
    fonts: u32,
    /// Number of icon records sharing the MAX_ASSETS bound with fonts.
    icons: u32,
    /// Number of glyph records, bounded by MAX_ASSET_GLYPHS.
    glyphs: u32,
    /// Combined UTF-8 name storage; at most 2048 bytes times the declared font-plus-icon count.
    names: u32,
}

#[version(1)]
/// Font metrics and an exact partition of the bulk glyph table.
struct AssetFont {
    /// Nonempty UTF-8 font name, at most MAX_ASSET_NAME_BYTES (2048), unique among fonts.
    name: AssetRange,
    /// Contiguous glyph records; fonts partition the table in declaration order.
    glyphs: AssetRange,
    /// Positive distance between text baselines in pixels.
    line_size: i32,
    /// Baseline offset from the top of the line.
    baseline: i32,
    /// Positive requested pixel size used to construct this font.
    font_size: i32,
}

#[version(1)]
/// One Unicode scalar's immutable measurement and texture coordinates.
struct AssetGlyph {
    /// Valid Unicode scalar; duplicate characters in a font are rejected.
    scalar: u32,
    /// Horizontal offset from the text cursor in pixels.
    offset_x: i32,
    /// Vertical offset from the text cursor in pixels.
    offset_y: i32,
    /// Horizontal cursor advance in pixels.
    advance_x: i32,
    /// Vertical cursor advance in pixels.
    advance_y: i32,
    /// Nonnegative rectangle wholly inside the atlas; empty glyphs are permitted.
    rect: Rect,
}

#[version(1)]
/// A named positive atlas rectangle; the required white icon must be opaque white.
struct AssetIcon {
    /// Nonempty UTF-8 name, at most MAX_ASSET_NAME_BYTES (2048), unique among icons.
    name: AssetRange,
    /// Positive rectangle wholly inside the atlas.
    rect: Rect,
}

#[version(1)]
/// Structural surface role whose table entries vary only by availability.
#[dense]
#[names(snake_case)]
enum SurfaceRole: u8 {
    /// Window or modal-dialog background below application content and chrome.
    Window = 0,
    /// Generic frame requested through the common FRAME widget option.
    GenericFrame = 1,
    /// Content panel or scroll-area viewport background.
    Panel = 2,
}

#[version(1)]
/// Interactive control part sharing pointer and keyboard-focus behavior.
#[dense]
#[names(snake_case)]
enum ControlRole: u8 {
    /// Ordinary command button or button-like list box.
    Button = 0,
    /// Checkbox square; checked state is painted independently.
    Checkbox = 1,
    /// Single-line, multiline, or numeric text input background.
    TextInput = 2,
    /// Generic item or tree row whose state supplies transient selection.
    Item = 3,
    /// Combo-box header.
    Combo = 4,
    /// Slider background track.
    SliderTrack = 5,
    /// Slider value thumb.
    SliderThumb = 6,
    /// Scrollbar background track.
    ScrollbarTrack = 7,
    /// Scrollbar movable thumb.
    ScrollbarThumb = 8,
    /// Window close caption button.
    CloseButton = 9,
    /// Window minimize caption button.
    MinimizeButton = 10,
    /// Window maximize caption button.
    MaximizeButton = 11,
    /// Window restore caption button used while maximized.
    RestoreButton = 12,
    /// Visible bottom-right resize grip.
    ResizeGrip = 13,
}

#[version(1)]
/// Menu-owned surface or entry role with menu-specific open-selection behavior.
#[dense]
#[names(snake_case)]
enum MenuRole: u8 {
    /// Menu bar spanning a window.
    Bar = 0,
    /// Menu-bar title which can own an open popup.
    Title = 1,
    /// Popup-menu panel.
    Popup = 2,
    /// Ordinary menu item or submenu row.
    Item = 3,
}

#[version(1)]
/// Manager-owned window chrome role whose presentation follows activation.
#[dense]
#[names(snake_case)]
enum ChromeRole: u8 {
    /// Ordinary-window outer frame decoration.
    WindowFrame = 0,
    /// Modal-dialog outer frame decoration.
    DialogFrame = 1,
    /// Window title patch and semantic-content color.
    Title = 2,
}

#[version(1)]
/// Semantic icon role required in every complete UI asset bundle.
#[dense]
#[names(snake_case)]
enum IconRole: u8 {
    /// Window and dialog close affordance.
    Close = 0,
    /// Collapsed disclosure affordance.
    Expand = 1,
    /// Expanded disclosure affordance.
    Collapse = 2,
    /// Checked checkbox and menu-item mark.
    Check = 3,
    /// Combo-box dropdown affordance.
    ExpandDown = 4,
    /// Open-folder file-dialog item.
    OpenFolder = 5,
    /// Closed-folder file-dialog item.
    ClosedFolder = 6,
    /// Regular file-dialog item.
    File = 7,
}

#[version(1)]
/// Semantic font selection resolved from the current immutable GFX bundle.
#[dense]
#[names(snake_case)]
enum FontRole: u8 {
    /// Ordinary control and body text.
    Body = 0,
    /// Compact supporting text.
    Small = 1,
    /// Window-title typography.
    Title = 2,
    /// Larger display typography.
    Heading = 3,
    /// Monospace typography.
    Mono = 4,
}

#[version(2)]
/// Four nonnegative pixel insets used by resolved theme geometry.
struct Insets {
    /// Leading horizontal thickness.
    left: i32,
    /// Leading vertical thickness.
    top: i32,
    /// Trailing horizontal thickness.
    right: i32,
    /// Trailing vertical thickness.
    bottom: i32,
}

#[version(2)]
/// Complete scalar layout recipe; installation rejects negative dimensions.
#[persistence(default)]
struct AssetMetrics {
    /// Preferred width when a layout supplies none.
    default_cell_width: i32,
    /// Inner control padding.
    padding: i32,
    /// Window body padding independent of controls.
    window_content_insets: Insets,
    /// Distance between neighboring cells.
    spacing: i32,
    /// Nested content indentation.
    indent: i32,
    /// Window title height.
    title_height: i32,
    /// Structural top-level border thickness.
    window_border: Insets,
    /// Scrollbar transverse size.
    scrollbar_size: i32,
    /// Minimum scrollbar and slider thumb size.
    thumb_size: i32,
}

#[version(1)]
/// Window title placement within the available caption geometry.
    enum TitleAlignment: u8 {
        /// Start at the leading edge.
        Leading = 0,
        /// Center within the title, reserving symmetric caption banks.
        Centered = 1,
    }

#[version(1)]
/// Caption bank containing one window control.
    enum CaptionSide: u8 {
        /// Place in the leading bank.
        Leading = 0,
        /// Place in the trailing bank.
        Trailing = 1,
    }

#[version(1)]
/// Complete caption and title geometry; boolean fields accept only zero or one.
struct AssetChrome {
    /// Leading or centered title placement.
    title_alignment: TitleAlignment,
    /// Leading or trailing close button bank.
    close_side: CaptionSide,
    /// Leading or trailing minimize button bank.
    minimize_side: CaptionSide,
    /// Leading or trailing maximize button bank.
    maximize_side: CaptionSide,
    /// Pixels above and below square captions.
    vertical_spacing: i32,
    /// Minimum caption extent.
    minimum_extent: i32,
    /// Gap between title and nonempty caption banks.
    inner_spacing: i32,
    /// Whether inactive captions remain visible and hittable, zero or one.
    show_without_activation: u8,
    /// Body height retained when minimized.
    minimized_content_height: i32,
    /// Whether the active title has a flat backdrop, zero or one.
    has_backdrop: u8,
    /// Backdrop color, packed R | G<<8 | B<<16 | A<<24.
    backdrop_rgba: u32,
    /// Additional pixels on each side of backdrop text.
    backdrop_padding: i32,
}

#[version(1)]
/// Resolved nine-patch artwork; colors use the renderer's packed RGBA convention.
enum AssetPatch: u8 {
    /// Nine independent cells; alpha zero means no visible cell.
    Flat {
        /// Top-left corner color.
        top_left: u32,
        /// Top edge color.
        top: u32,
        /// Top-right corner color.
        top_right: u32,
        /// Left edge color.
        left: u32,
        /// Center color.
        center: u32,
        /// Right edge color.
        right: u32,
        /// Bottom-left corner color.
        bottom_left: u32,
        /// Bottom edge color.
        bottom: u32,
        /// Bottom-right corner color.
        bottom_right: u32,
    },
    /// One bundle-local icon sliced into nine source cells.
    Image {
        /// Index in this bundle's icon table, never a native texture handle.
        icon: u32,
        /// Nonnegative source slices. Oversized opposing slices shrink proportionally;
        /// GFX overlays visible image cells with pink at 0.5 opacity when source shrinking occurs.
        source: Insets,
        /// Color modulation applied to every sampled cell.
        tint: u32,
    },
}

#[version(1)]
/// One resolved state value; geometry and content color are transferred together.
struct AssetVisual {
    /// Destination-space slicing thickness.
    insets: Insets,
    /// Whether to include the stretchable center, zero or one.
    center_visible: u8,
    /// Text and semantic-icon color in packed RGBA order.
    content_color: u32,
    /// Validated flat cells or a bundle-local image reference.
    patch: AssetPatch,
}

#[version(1)]
/// Both availability appearances for one structural surface role.
struct AssetSurfaceVisuals {
    /// Surface belonging to an enabled retained subtree.
    normal: AssetVisual,
    /// Surface belonging to a disabled retained subtree.
    disabled: AssetVisual,
}

#[version(1)]
/// Pointer appearances nested inside one enabled or focused control branch.
struct AssetPointerVisuals {
    /// Pointer is not hovering or pressing the control.
    normal: AssetVisual,
    /// Pointer is hovering the control without an active press.
    hovered: AssetVisual,
    /// Pointer capture is pressed while the pointer remains over the control.
    pressed: AssetVisual,
}

#[version(1)]
/// Complete non-contradictory appearances for one interactive control role.
struct AssetControlVisuals {
    /// Control is unavailable; pointer and focus appearances do not apply.
    disabled: AssetVisual,
    /// Pointer appearances while available without visible keyboard focus.
    enabled: AssetPointerVisuals,
    /// Pointer appearances while the control owns visible keyboard focus.
    focused: AssetPointerVisuals,
}

#[version(1)]
/// Complete menu-specific appearances for one menu role.
struct AssetMenuVisuals {
    /// Enabled appearance without transient selection.
    normal: AssetVisual,
    /// Pointer-hover selection appearance.
    hovered: AssetVisual,
    /// Visible pointer-press selection appearance.
    pressed: AssetVisual,
    /// Keyboard-navigation selection appearance.
    focused: AssetVisual,
    /// Appearance of an entry that owns an open popup.
    open: AssetVisual,
    /// Appearance of an unavailable menu surface or entry.
    disabled: AssetVisual,
}

#[version(1)]
/// Complete activation and availability appearances for one window chrome role.
struct AssetChromeVisuals {
    /// Enabled chrome for a window that does not own activation.
    base: AssetVisual,
    /// Enabled chrome for the active window.
    active: AssetVisual,
    /// Chrome belonging to a disabled window.
    disabled: AssetVisual,
}

#[version(1)]
/// Logical resource namespace authenticated by canonical COM identity.
/// Derived bundles retain this capability and preserve the meaning of existing names.
/// Independently created catalogs remain unrelated even when their names match.
interface IAssetCatalog {}

#[version(4)]
/// Immutable, self-contained resource revision. Every copy writes the exact requested range.
/// Names partition their byte table in font-then-icon order. Fonts require an underscore
/// fallback; body and the standard semantic icon names are mandatory. Consumers import
/// once, validating all records and pixels before publication. No per-glyph COM calls occur.
interface IAssetBundle {
    /// Retains immutable atlas storage independently of this revision's metadata.
    /// Repeated calls return the same image identity. Appearance-only revisions retain
    /// that identity and its bytes; resource rebuilds publish a new image. The image
    /// size agrees with info().size and its lifetime does not depend on the bundle.
    fn image(&self) -> Result<ComPtr<IRgbaImage>>;
    /// Retains the logical namespace shared by compatible derived revisions.
    fn catalog(&self) -> Result<ComPtr<IAssetCatalog>>;
    /// Returns bounded allocation counts and dimensions.
    fn info(&self) -> Result<AssetInfo>;
    /// Copies contiguous font records.
    fn fonts(&self, output: &mut [AssetFont]) -> Result<()>;
    /// Copies contiguous glyph records.
    fn glyphs(&self, output: &mut [AssetGlyph]) -> Result<()>;
    /// Copies contiguous icon records.
    fn icons(&self, output: &mut [AssetIcon]) -> Result<()>;
    /// Copies the exact UTF-8 name pool without NUL terminators.
    fn names(&self, output: &mut [u8]) -> Result<()>;
    /// Returns complete scalar layout metrics.
    fn metrics(&self) -> Result<AssetMetrics>;
    /// Returns complete window chrome policy.
    fn chrome(&self) -> Result<AssetChrome>;
    /// Copies one complete surface-state record for each SurfaceRole in declaration order.
    fn surface_visuals(&self, output: &mut [AssetSurfaceVisuals]) -> Result<()>;
    /// Copies one complete nested control-state record for each ControlRole in declaration order.
    fn control_visuals(&self, output: &mut [AssetControlVisuals]) -> Result<()>;
    /// Copies one complete menu-state record for each MenuRole in declaration order.
    fn menu_visuals(&self, output: &mut [AssetMenuVisuals]) -> Result<()>;
    /// Copies one complete chrome-state record for each ChromeRole in declaration order.
    fn chrome_visuals(&self, output: &mut [AssetChromeVisuals]) -> Result<()>;
}

/// Named flat colors used as inputs to visual-catalog construction.
///
/// A palette is an authoring value, not retained runtime appearance state. Compiling it eagerly into
/// complete resolved visual values avoids the former shadow color array that could disagree with
/// what widgets actually painted.
#[version(2)]
#[persistence(default)]
struct FlatPalette {
    /// Ordinary control text and semantic glyph color.
    text: Color,
    /// Generic flat frame and control border color.
    border: Color,
    /// Window and dialog client-area background.
    window_background: Color,
    /// Base window title background used when the active chrome role is not selected.
    title_background: Color,
    /// Window title and caption foreground.
    title_foreground: Color,
    /// Panel and scroll-viewport background.
    panel_background: Color,
    /// Ordinary raised-control fill.
    button: Color,
    /// Hovered raised-control fill.
    button_hovered: Color,
    /// Ordinary recessed-control fill.
    input: Color,
    /// Hovered recessed-control fill.
    input_hovered: Color,
    /// Scrollbar track fill.
    scrollbar_track: Color,
    /// Scrollbar thumb fill.
    scrollbar_thumb: Color,
    /// Focused control border or fill accent.
    control_focus: Color,
    /// Background used by hovered, keyboard-focused, open, or otherwise selected items.
    selection_background: Color,
    /// Text and glyph color paired with [`Self::selection_background`].
    selection_foreground: Color,
    /// Active window frame and title accent.
    window_active: Color,
    /// Menu text and marker foreground.
    menu_foreground: Color,
    /// Menu bar and popup background.
    menu_background: Color,
    /// Disabled control and client-area background.
    disabled_background: Color,
    /// Disabled body, menu, and control foreground.
    disabled_foreground: Color,
    /// Disabled title and caption foreground.
    disabled_title_foreground: Color,
}
