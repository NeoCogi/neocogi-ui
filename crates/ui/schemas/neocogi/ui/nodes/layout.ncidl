#[version(1)]
/// One parent-owned track; variants carry only the data relevant to their policy.
enum LayoutTrack: u8 {
    /// Uses the child's intrinsic preferred extent.
    Content,
    /// Uses an exact nonnegative pixel extent.
    Fixed {
        /// Exact nonnegative pixel extent.
        extent: i32,
    },
    /// Receives a positive weighted share; the weight must remain positive in checked S51.12.
    Flex {
        /// Finite positive input, checked for range and rounding-to-zero before mutation.
        weight: f32,
    },
}

#[version(1)]
/// Shared cross-axis size of a linear container's line.
enum CrossSize: u8 {
    /// Fits the largest child's preferred cross extent.
    Content,
    /// Reports preferred content, then stretches to its exact placement allocation.
    Stretch,
    /// Uses an exact nonnegative pixel extent.
    Fixed {
        /// Exact nonnegative pixel extent.
        extent: i32,
    },
}

#[version(1)]
/// Optional exact child cross extent; Stretch uses the owning linear line's cross size.
enum ChildCrossSize: u8 {
    /// Uses the line's resolved cross extent.
    Stretch,
    /// Uses an exact nonnegative pixel extent.
    Fixed {
        /// Exact nonnegative pixel extent.
        extent: i32,
    },
}

#[version(1)]
/// Main axis and leading edge, without independent potentially inconsistent flags.
    enum FlowDirection: u8 {
        /// Horizontal sequence starting at the left edge.
        LeftToRight = 0,
        /// Horizontal sequence starting at the right edge.
        RightToLeft = 1,
        /// Vertical sequence starting at the top edge.
        TopToBottom = 2,
        /// Vertical sequence starting at the bottom edge.
        BottomToTop = 3,
    }

#[version(1)]
/// Linear-owned relationship stored beside one direct child.
struct LinearEdge {
    /// Main-axis content, exact or weighted-flexible policy.
    main: LayoutTrack,
    /// Optional exact cross extent for this child only.
    cross: ChildCrossSize,
}

#[version(1)]
/// Positive Grid-owned cell span; placement clamps columns at the right grid boundary.
/// Row-major search skips any candidate whose effective rectangle intersects an earlier child.
struct GridExtent {
    /// Number of logical columns, greater than zero.
    columns: u32,
    /// Number of logical rows, greater than zero.
    rows: u32,
}

#[version(1)]
/// Constructible directional container whose concrete editing API is one class contract.
interface Linear: IWidget + IContainerLayout {
    /// Returns the stable read-only topology view for this container's lifetime.
    fn children(&self) -> Result<ComPtr<IChildren>>;
    /// Removes one complete subtree and matching edge metadata.
    fn remove(&mut self, index: u32) -> Result<()>;
    /// Removes all owned subtrees and matching metadata while retaining reusable capacity.
    fn clear(&mut self) -> Result<()>;
    /// Returns its complete axis and leading-edge policy.
    fn direction(&self) -> Result<FlowDirection>;
    /// Replaces the direction without reordering child ownership.
    fn set_direction(&mut self, direction: FlowDirection) -> Result<()>;
    /// Returns the shared cross-axis size policy.
    fn cross_size(&self) -> Result<CrossSize>;
    /// Validates and replaces the shared cross-axis policy.
    fn set_cross_size(&mut self, cross: CrossSize) -> Result<()>;
    /// Returns one child's exact parent-owned sizing relationship.
    fn edge(&self, index: u32) -> Result<LinearEdge>;
    /// Replaces sizing metadata without replacing the child's identity.
    fn set_edge(&mut self, index: u32, edge: LinearEdge) -> Result<()>;
    /// Validates child and relationship before committing insertion at index, including count.
    fn insert(&mut self, index: u32, child: ComBox<IWidget>, edge: LinearEdge) -> Result<()>;
    /// Validates replacement before permanently closing the previous indexed subtree.
    fn replace(&mut self, index: u32, child: ComBox<IWidget>, edge: LinearEdge) -> Result<()>;
}

#[version(1)]
/// Immutable application ceilings for explicit tracks and cumulative implicit Grid placement.
/// These are maxima, not initial sizes; the product bounds occupancy storage and search.
/// Both values must be positive, at most i32::MAX, with a product fitting isize.
struct GridLimits {
    /// Maximum effective columns, including the implicit column of an empty track list.
    max_columns: u32,
    /// Maximum effective rows, including all child spans and implicit rows.
    max_rows: u32,
}

#[version(1)]
/// Constructible Grid whose topology, spans, and both track axes share one class contract.
interface Grid: IWidget + IContainerLayout {
    /// Returns the immutable resource ceilings chosen by this Grid's constructor.
    fn limits(&self) -> Result<GridLimits>;
    /// Returns the stable read-only topology view for this container's lifetime.
    fn children(&self) -> Result<ComPtr<IChildren>>;
    /// Prepares bounded reflow before removing a subtree; failure preserves its owner.
    fn remove(&mut self, index: u32) -> Result<()>;
    /// Removes all owned subtrees and metadata without a replacement-placement allocation.
    fn clear(&mut self) -> Result<()>;
    /// Copies a range of column policies; offset indexes tracks and the return value is total count.
    fn columns(&self, output: &mut [LayoutTrack]) -> Result<u32>;
    /// Prepares bounded placement under the new columns before changing tracks; input offset must be zero.
    fn set_columns(&mut self, tracks: &[LayoutTrack]) -> Result<()>;
    /// Copies a range of row policies; offset indexes tracks and the return value is total count.
    fn rows(&self, output: &mut [LayoutTrack]) -> Result<u32>;
    /// Replaces rows only when all tracks fit the immutable ceiling; input offset must be zero.
    fn set_rows(&mut self, tracks: &[LayoutTrack]) -> Result<()>;
    /// Returns one child's positive Grid-owned span.
    fn edge(&self, index: u32) -> Result<GridExtent>;
    /// Prepares complete bounded placement before changing a span; rejection preserves all metadata.
    fn set_edge(&mut self, index: u32, edge: GridExtent) -> Result<()>;
    /// Prepares bounded non-overlapping placement before accepting an unmounted child.
    /// Failure preserves the existing tree and returns the exact unconsumed owner.
    fn insert(&mut self, index: u32, child: ComBox<IWidget>, edge: GridExtent) -> Result<()>;
    /// Prepares complete bounded placement before replacing and dropping the old subtree.
    /// Failure returns the incoming owner and preserves the old subtree and metadata.
    fn replace(&mut self, index: u32, child: ComBox<IWidget>, edge: GridExtent) -> Result<()>;
}

#[version(1)]
/// Axis along which the divider and pane extents move.
enum SplitAxis: u8 {
    /// First pane on the left, second on the right, with a vertical divider.
    Horizontal = 0,
    /// First pane above the second, with a horizontal divider.
    Vertical = 1,
}

#[version(1)]
/// Complete pixel-based sizing policy for a two-pane split view.
struct SplitOptions {
    /// Movement axis; child ownership order always stays first, then second.
    axis: SplitAxis,
    /// Requested first-pane extent, preserved when temporary bounds force clamping.
    position: i32,
    /// Nonnegative minimum first-pane extent when the allocation permits it.
    minimum_first: i32,
    /// Nonnegative minimum second-pane extent when the allocation permits it.
    minimum_second: i32,
    /// Positive divider thickness used by both painting and hit testing.
    handle_width: i32,
}

#[version(1)]
/// Two-pane layout with a draggable divider owned by this same concrete container.
/// Zero children is empty; one fills the allocation; two enable the divider.
interface SplitView: IWidget + IContainerLayout {
    /// Returns immutable topology; indices zero and one identify first and second panes.
    fn children(&self) -> Result<ComPtr<IChildren>>;
    /// Inserts one unmounted pane at index, rejecting a third child before attachment.
    fn insert(&mut self, index: u32, child: ComBox<IWidget>) -> Result<()>;
    /// Replaces one pane after validation, permanently closing its previous subtree.
    fn replace(&mut self, index: u32, child: ComBox<IWidget>) -> Result<()>;
    /// Closes one pane; the remaining pane fills the allocation.
    fn remove(&mut self, index: u32) -> Result<()>;
    /// Closes both panes while keeping this container available for new content.
    fn clear(&mut self) -> Result<()>;
    /// Returns requested sizing, independent of temporary allocation clamping.
    fn settings(&self) -> Result<SplitOptions>;
    /// Validates all settings before mutation and ends any active divider gesture.
    fn set_settings(&mut self, settings: SplitOptions) -> Result<()>;
    /// Changes only the nonnegative requested position, retaining the current axis,
    /// minima and handle width. Allocation clamping never rewrites this request.
    /// A changed request cancels the gesture and invalidates layout without a user event;
    /// invalid or closed calls leave the settings unchanged.
    fn set_position(&mut self, position: i32) -> Result<()>;
}

#[version(1)]
/// Constructible scroll composite with one replaceable content root and private structural roles.
interface ScrollArea: IWidget + IContainerLayout + IScrolling {
    /// Returns the actual application content widget, without its surrounding transform surface.
    fn content(&self) -> Result<WeakComBox<IWidget>>;
    /// Validates replacement before closing old content; structural roles and model identity stay fixed.
    fn replace_content(&mut self, content: ComBox<IWidget>) -> Result<()>;
}

#[version(1)]
/// Immutable disclosure presentation; expansion and child ownership use one shared policy.
    enum DisclosureStyle: u8 {
        /// Full framed header above the body.
        Header = 0,
        /// Compact tree row with an indented body.
        Tree = 1,
    }

#[version(1)]
/// Constructible fixed header/body composition exposing its actual editable child objects.
interface Disclosure: IWidget + IContainerLayout {
    /// Returns shared expansion state also changed by header activation and keyboard input.
    fn expanded(&self) -> Result<bool>;
    /// Changes expansion and retains layout invalidation even while this subtree is hidden.
    fn set_expanded(&mut self, expanded: bool) -> Result<()>;
    /// Returns the real header's text capability, including its inherited widget options.
    fn header(&self) -> Result<WeakComBox<ITextContent>>;
    /// Returns the real body container; its child editor keeps topology and edge metadata consistent.
    fn body(&self) -> Result<WeakComBox<Linear>>;
}

#[version(1)]
/// Fixed-coordinate form; rectangles belong to the parent, in content pixels.
/// Children paint in insertion order, so later siblings appear above earlier ones.
interface Form: IWidget + IContainerLayout {
    /// Returns read-only topology; edits cannot bypass rectangle validation.
    fn children(&self) -> Result<ComPtr<IChildren>>;
    /// Removes and destroys one subtree together with its rectangle.
    fn remove(&mut self, index: u32) -> Result<()>;
    /// Closes all children and clears their rectangles.
    fn clear(&mut self) -> Result<()>;
    /// Returns the authored preferred content size, independent of allocation.
    fn size(&self) -> Result<Size>;
    /// Changes the preferred form size without scaling child rectangles.
    fn set_size(&mut self, size: Size) -> Result<()>;
    /// Returns a child's parent-relative rectangle.
    fn edge(&self, index: u32) -> Result<Rect>;
    /// Moves or resizes a child without replacing its identity.
    fn set_edge(&mut self, index: u32, edge: Rect) -> Result<()>;
    /// Validates a rectangle before attaching an unmounted child.
    fn insert(&mut self, index: u32, child: ComBox<IWidget>, edge: Rect) -> Result<()>;
    /// Commits a new child and rectangle and destroys the old child owner.
    fn replace(&mut self, index: u32, child: ComBox<IWidget>, edge: Rect) -> Result<()>;
}
