#[version(1)]
/// Constructible button interface with only its shared widget and leaf-layout protocols separated.
interface Button: IWidget + ILeafLayout {

    /// Replaces the complete UTF-8 label; the logical input offset must be zero.
    fn set_label(&mut self, label: &[u8]) -> Result<()>;

    /// Returns the current label as an independently owned immutable string object.
    fn label(&self) -> Result<ComPtr<INcString>>;

    /// Selects a semantic font role and invalidates measurement only when it differs.
    fn set_font_role(&mut self, role: FontRole) -> Result<()>;

    /// Resolves an exact named font in the current host bundle before committing.
    fn set_named_font(&mut self, name: &[u8]) -> Result<()>;

    /// Selects a semantic icon or removes it while retaining the label.
    fn set_icon_role(&mut self, icon: ContentIcon) -> Result<()>;

    /// Resolves an exact named icon in the current host bundle before committing.
    fn set_named_icon(&mut self, name: &[u8]) -> Result<()>;

    /// Returns the interaction states that fill an unframed button's center.
    fn fill_states(&self) -> Result<FillStates>;

    /// Replaces the validated paint-only center-fill mask.
    fn set_fill_states(&mut self, states: FillStates) -> Result<()>;

    /// Installs a positive-sized renderer-owned image, optionally fitted to width.
    fn set_image(&mut self, image: &ITexture, fit_width: bool) -> Result<()>;

    /// Removes image content while retaining the current label and font.
    fn clear_image(&mut self) -> Result<()>;
}

#[version(1)]
/// Runtime-bound construction shorthand over concrete built-in node contracts and compositions.
interface UiFactory: IConstructionHost + IFileDialogs {

    /// Creates a fixed scrolling multiline editor; CRLF and CR normalize to LF and the cursor starts at the end.
    fn create_text_area(&self, text: &[u8], wrapping: TextWrapping, scrolling: bool, events: &EventBinding) -> Result<ComBox<TextArea>>;
    /// Creates an empty disclosure with a real text header and editable vertical Linear body.
    fn create_disclosure(&self, label: &[u8], style: DisclosureStyle, expanded: bool) -> Result<ComBox<Disclosure>>;
    /// Creates a framed scroll composite around one unmounted content object; generic options can subsequently change its frame.
    fn create_scroll_area(&self, content: ComBox<IWidget>, enabled: bool) -> Result<ComBox<ScrollArea>>;
    /// Creates an empty directional container after validating its complete initial policy.
    fn create_linear(&self, direction: FlowDirection, cross: CrossSize) -> Result<ComBox<Linear>>;
    /// Creates an empty split view; panes attach through its validated two-child editor.
    fn create_split_view(&self, settings: SplitOptions, events: &EventBinding) -> Result<ComBox<SplitView>>;
    /// Creates a fixed-coordinate form with a positive preferred content size.
    /// Dimensions affect preferred geometry only; initial requested flags are size-independent.
    fn create_form(&self, size: Size) -> Result<ComBox<Form>>;
    /// Creates an empty Grid with validated tracks and immutable caller-selected limits.
    /// Input offsets must be zero; explicit and implicit tracks obey the same ceilings.
    /// Zero limits are invalid; excessive counts/products return OUT_OF_RANGE, and
    /// failed placement reservations return OUT_OF_MEMORY before ownership changes.
    fn create_grid(
        &self,
        columns: &[LayoutTrack],
        rows: &[LayoutTrack],
        limits: GridLimits,
    ) -> Result<ComBox<Grid>>;
    /// Constructs an unmounted boolean control with body-font presentation.
    fn create_checkbox(&self, checked: bool, label: &[u8], events: &EventBinding) -> Result<ComBox<Checkbox>>;
    /// Constructs an unmounted normalized single-line editor.
    fn create_textbox(&self, text: &[u8], events: &EventBinding) -> Result<ComBox<Textbox>>;
    /// Constructs multiline display text using the explicit wrapping policy.
    fn create_text_block(&self, text: &[u8], wrapping: TextWrapping) -> Result<ComBox<TextBlock>>;
    /// Constructs a slider after validating every arithmetic input.
    fn create_slider(&self, options: SliderOptions, events: &EventBinding) -> Result<ComBox<Slider>>;
    /// Constructs standalone numeric entry after validating arithmetic inputs.
    fn create_number(&self, options: NumberOptions, events: &EventBinding) -> Result<ComBox<Number>>;
    /// Constructs an RGBA swatch with an optional label.
    fn create_color_swatch(&self, rgba: u32, label: &[u8]) -> Result<ComBox<ColorSwatch>>;
    /// Constructs one list row; application data is attached in its static adapter.
    fn create_list_item(&self, label: &[u8], events: &EventBinding) -> Result<ComBox<ListItem>>;
    /// Constructs a button-like list entry.
    fn create_list_box(&self, label: &[u8], events: &EventBinding) -> Result<ComBox<ListBox>>;
    /// Constructs a scrollbar with a validated orientation and normalized range.
    fn create_scrollbar(&self, range: ScrollRange, events: &EventBinding) -> Result<ComBox<Scrollbar>>;
    /// Constructs an initialized, unmounted Button using its provider-owned defaults.
    /// Explicit presentation overrides use IWidget.replace_flags after construction.
    fn create_button(&self, label: &[u8], events: &EventBinding) -> Result<ComBox<Button>>;
    /// Atomically binds one combo header, choice-menu popup, and validated model to its window.
    fn create_combo_box(
        &self,
        parent: &IWindow,
        menu_text: &[u8],
        entries: &[ChoiceMenuEntry],
        selection: ChoiceSelection, events: &EventBinding) -> Result<ComBox<Combo>>;
}

#[version(1)]
/// Stateless activation root for the independently deployed built-in nodes plugin.
interface NodesPluginFactory {
    /// Binds one concrete node interface to public services exposed by the supplied core runtime.
    fn bind(&self, runtime: &UiRuntime) -> Result<ComPtr<UiFactory>>;
}
