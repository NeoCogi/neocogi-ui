
#[version(2)]
/// Activation occurrence shared by buttons, list items and menu commands.
/// The envelope supplies exact source identity; display labels are not event data.
interface IActivatedEvent: IEvent {}

#[version(1)]
/// Immutable committed edit, independent of the editor's current text and cursor.
interface ITextChangedEvent: IEvent {
    /// Complete normalized UTF-8 snapshot.
    fn text(&self) -> Result<ComPtr<INcString>>;
    /// UTF-8 byte cursor at a scalar boundary within this snapshot.
    fn cursor(&self) -> Result<u64>;
}

#[version(1)]
/// Immutable submission, distinct from a text change even when the text is equal.
interface ITextSubmittedEvent: IEvent {
    /// Complete text captured when the user submitted.
    fn text(&self) -> Result<ComPtr<INcString>>;
}

#[version(2)]
/// Common category for immutable window lifecycle facts.
interface IWindowEvent: IEvent {}

#[version(1)]
/// Captured window GeometryChanged fact, independent of the live source.
interface IWindowGeometryChangedEvent: IWindowEvent {
    /// Complete captured outer geometry.
    fn rect(&self) -> Result<Rect>;
}

#[version(1)]
/// Captured window CloseRequested fact, independent of the live source.
interface IWindowCloseRequestedEvent: IWindowEvent {
}

#[version(1)]
/// Captured window Hidden fact, independent of the live source.
interface IWindowHiddenEvent: IWindowEvent {
}

#[version(1)]
/// Captured window Destroyed fact, independent of the live source.
interface IWindowDestroyedEvent: IWindowEvent {
}

#[version(1)]
/// Captured window Minimized fact, independent of the live source.
interface IWindowMinimizedEvent: IWindowEvent {
    /// Complete captured outer geometry.
    fn rect(&self) -> Result<Rect>;
}

#[version(1)]
/// Captured window Maximized fact, independent of the live source.
interface IWindowMaximizedEvent: IWindowEvent {
    /// Complete captured outer geometry.
    fn rect(&self) -> Result<Rect>;
}

#[version(1)]
/// Captured window Restored fact, independent of the live source.
interface IWindowRestoredEvent: IWindowEvent {
    /// Complete captured outer geometry.
    fn rect(&self) -> Result<Rect>;
}

#[version(2)]
/// Captured dismissal; whole-runtime shutdown does not synthesize this fact.
interface IPopupDismissedEvent: IEvent {}

#[version(1)]
/// Immutable committed menu selection shared by choice menus and combo controls.
interface IChoiceChangedEvent: IEvent {
    /// Stable selection identity, including explicit absence.
    fn selection(&self) -> Result<ChoiceSelection>;
}

#[version(1)]
/// Accepted native file identity; a cancelled event does not implement this interface.
interface IFileAcceptedEvent: IEvent {
    /// Retained immutable native path; display text is never its identity.
    fn path(&self) -> Result<ComPtr<INativePath>>;
}

#[version(1)]
/// Cancellation fact with no path payload; distinct from an accepted empty path.
interface IFileCancelledEvent: IEvent {}
