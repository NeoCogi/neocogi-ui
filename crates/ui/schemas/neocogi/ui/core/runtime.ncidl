#[version(1)]
/// Scoped facade which appends typed operations to the runtime's current frame paint context.
interface IPainter {
    /// Reserves an ordered graphics contribution rooted in the committed visible client area.
    /// Finish or cancel the returned view before paint returns or another view begins. The root
    /// uses trusted layout geometry; caller-supplied scope values cannot enlarge it. A retained
    /// view expires on every paint return. Resource ownership remains with the granted domain.
    fn begin_render_view(&mut self, scope: PaintScope, resources: &IRenderResources) -> Result<ComBox<IRenderView>>;
    /// Records a nonnegative-width solid line with finite local endpoints. Zero width draws nothing.
    fn stroke_line(&mut self, scope: PaintScope, from: PaintPoint, to: PaintPoint, width: f32, rgba: u32) -> Result<()>;
    /// Records finite local polygon points at offset zero; fewer than three points draw nothing.
    /// Concave polygon tessellation and clipping use the same UI implementation as built-in drawing.
    fn fill_polygon(&mut self, scope: PaintScope, points: &[PaintPoint], rgba: u32) -> Result<()>;
    /// Records solid triangles in widget-local coordinates. The complete input starts at offset zero,
    /// has a multiple of three vertices and contains only finite positions. Atlas mapping belongs
    /// to the UI implementation and follows the currently installed resource revision.
    fn colored_triangles(&mut self, scope: PaintScope, vertices: &[ColoredVertex]) -> Result<()>;
    /// Records complete atlas triangles in local coordinates; offset is zero,
    /// length is divisible by three, and every position/UV component is finite.
    fn triangles(&mut self, scope: PaintScope, vertices: &[RenderVertex]) -> Result<()>;
    /// Retains an immutable renderer-owned RGBA texture and draws its normalized source region in local coordinates.
    /// Negative extents are invalid; zero extents draw nothing. Ownership is validated before GPU execution.
    fn texture(&mut self, scope: PaintScope, rect: Rect, source: TextureRegion, rgba: u32, texture: &ITexture) -> Result<()>;
    /// Records a fill only while this exact invocation remains active.
    fn fill(&mut self, scope: PaintScope, rect: Rect, rgba: u32) -> Result<()>;
    /// Records UTF-8 text with the current body font and button content style.
    fn text(&mut self, scope: PaintScope, rect: Rect, text: &[u8]) -> Result<()>;
    /// Resolves and records one semantic surface or control frame, returning its usable interior.
    /// `center_only` removes destination insets without changing the selected artwork.
    fn frame(&mut self, scope: PaintScope, rect: Rect, role: WidgetFrame, state: WidgetVisualState, center_only: bool) -> Result<Rect>;
    /// Records one atlas icon selected by its slot in the current immutable asset bundle.
    fn icon(&mut self, scope: PaintScope, icon: PaintIcon, rect: Rect, rgba: u32) -> Result<()>;
    /// Records one UTF-8 text run at an explicit local baseline-aligned position.
    fn text_run(&mut self, scope: PaintScope, font: PaintFont, position: Point, rgba: u32, text: &[u8]) -> Result<()>;
}

#[version(1)]
/// Common widget capability; factories return one ComBox owner, containers consume it,
/// and application observers use WeakComBox. Owner removal rejects new calls;
/// admitted calls finish before provider destruction. There is no widget close method.
interface IWidget {
    /// Returns the allocating runtime's identity service, which owns no tree.
    fn host(&self) -> Result<ComPtr<IWidgetHost>>;
    /// Claims the only tree attachment; a second call fails without changing state.
    fn mount(&mut self) -> Result<()>;

    /// Returns effective frame, focus and input policy, including behavior-derived flags.
    /// This observation is not requested configuration and must not be written back as such.
    fn properties(&self) -> Result<WidgetProperties>;
    /// Returns current requested configuration, initialized by the concrete constructor.
    /// Excludes behavior-derived flags from properties(); safe to use as the baseline
    /// for explicit authoring edits. Setters change this value; it is not a saved
    /// copy of construction defaults. Uses the same readable-lifetime checks as properties.
    fn requested_flags(&self) -> Result<WidgetOptions>;
    /// Replaces all current requested flags; unspecified flags are cleared.
    /// Rejects unknown bits and forbidden mutations before changing state. A real change
    /// records sticky geometry invalidation; an identical replacement preserves that marker.
    fn replace_flags(&mut self, flags: WidgetOptions) -> Result<()>;
    /// Sets selected bits in the widget's current requested flags, preserving all other bits.
    /// Uses the same validation, lifetime and invalidation contract as replace_flags.
    /// Never captures effective flags or restores construction-time settings.
    fn set_flags(&mut self, flags: WidgetOptions) -> Result<()>;
    /// Clears selected bits in the widget's current requested flags, preserving all other bits.
    /// Rejects unknown mask bits even when they would clear nothing. Clearing absent bits
    /// is a no-op and must not erase an earlier pending geometry change.
    fn clear_flags(&mut self, flags: WidgetOptions) -> Result<()>;
    /// Processes one router-owned snapshot; the text argument is UTF-8 only for Text events.
    /// Runtime dispatch scopes the current event origin for this synchronous call.
    /// Return CHANGED for every modification to measurement or child placement inputs.
    fn update(&mut self, state: WidgetUpdate, event: WidgetEvent, text: &[u8]) -> Result<GeometryChange>;

    /// Drains sticky geometry invalidation recorded by programmatic setters.
    /// Every provider must also notify host.mark_geometry_changed for mutations of
    /// measurement, placement or routing policy, including hidden and unmounted values.
    /// Conservatively signal before a fallible commit or after an admitted commit;
    /// a post-commit failure must retain both the sticky marker and notification.
    /// Pre-commit rejection may leave a harmless notification but no sticky mutation.
    /// NoChange must preserve earlier markers. A truthful Changed update result is
    /// additionally notified by the runtime; independent setters cannot rely on polling.
    fn take_change(&mut self) -> Result<GeometryChange>;
    /// Records this widget's visual output within a validated paint invocation.
    fn paint(&mut self, scope: PaintScope, state: WidgetPaint, painter: &IPainter) -> Result<()>;
}

#[version(1)]
/// Optional private receiver/model behavior on the same exclusive widget allocation.
/// Passive widgets must not expose this capability. Its weak projection shares the widget's
/// lifetime and mutable gate. The runtime retains projections only on owned nodes and in
/// transient descendant-first update snapshots; no callback runs under a traversal borrow.
interface IWidgetDispatcher {
    /// Attempts at most one private message. False means idle; true charges the shared
    /// bounded update budget and reconsiders descendant work. Handler errors propagate
    /// unchanged and leave later messages queued. Topology changes require recollection
    /// even when the handler reports false. Removed receivers are never entered.
    /// The runtime scopes this composite as origin while its handler posts public events.
    fn dispatch_next(&mut self) -> Result<bool>;
}

#[version(1)]
/// Ordered child access, independent of concrete container layout policy.
interface IChildren {
    /// Returns the current number of direct children.
    fn child_count(&self) -> Result<u32>;
    /// Returns a cached weak observer to one direct child; it cannot transfer or retain ownership.
    fn child(&self, index: u32) -> Result<WeakComBox<IWidget>>;
}

#[version(1)]
/// Immutable resource view shared for a complete layout transaction.
interface ITextMetrics {
    /// Measures a UTF-8 button label, including theme padding.
    fn button_size(&self, text: &[u8]) -> Result<Size>;
}

#[version(1)]
/// Whether an axis has a finite measurement maximum.
    enum LimitKind: u8 {
        /// Extent is a nonnegative maximum; zero remains a real bound.
        Finite = 0,
        /// Preferred size is requested without a finite maximum; extent must be zero.
        Unbounded = 1,
    }

#[version(1)]
/// Copied axis constraint; the tag distinguishes zero from unbounded space.
struct AxisLimit {
    /// Explicit finite/unbounded interpretation.
    kind: LimitKind,
    /// Nonnegative bound for FINITE, zero for UNBOUNDED.
    extent: i32,
}

#[version(1)]
/// Independent horizontal and vertical measurement constraints.
struct LayoutLimits {
    /// Available horizontal space.
    width: AxisLimit,
    /// Available vertical space.
    height: AxisLimit,
}

#[version(1)]
/// Preferred-size capability for a leaf; measurement may refresh private resource caches.
interface ILeafLayout {
    /// Computes preferred dimensions from explicit finite/unbounded axis constraints.
    fn measure(&mut self, bounds: LayoutLimits, metrics: &ITextMetrics) -> Result<Size>;
}

#[version(1)]
/// Visibility intent or effective surface visibility, as documented by the operation.
    enum Visibility: u8 {
        /// Excluded from rendering and input.
        Hidden = 0,
        /// Eligible when structural and modal owner policy also permits it.
        Visible = 1,
    }

#[version(1)]
/// How a parent clips its structural child windows.
    enum ChildClip: u8 {
        /// Inherit the ancestor/viewport clip without narrowing to the parent's body.
        None = 0,
        /// Clip complete child surfaces to the parent's application content area.
        Content = 1,
    }

#[version(1)]
/// Structural layer category for a window or dialog.
    enum LayerKind: u8 {
        /// An independent or inherited application layer in 0..=15.
        Fixed = 0,
        /// Dedicated modal band above all application layers; number is zero.
        Modal = 1,
    }

#[version(1)]
/// Explicit fixed or manager-controlled modal stacking band.
struct WindowLayer {
    /// Interpretation of the numeric field.
    kind: LayerKind,
    /// Fixed application layer, or zero when modal.
    number: u8,
}

#[version(1)]
/// Concrete window presentation bits; unknown bits are rejected before mutation.
bitenum WindowOptions: u16 {
    /// No optional presentation behavior.
    NONE = 0,
    /// Show the minimize caption button.
    MINIMIZE_BUTTON = 1,
    /// Show the maximize caption button.
    MAXIMIZE_BUTTON = 2,
    /// Keep visible while disabling the complete structural family.
    DISABLED = 4,
    /// Remove the ordinary content inset.
    NO_PADDING = 8,
    /// Prevent interactive resizing.
    NO_RESIZE = 16,
    /// Hide the close caption button.
    NO_CLOSE = 64,
    /// Hide the title bar.
    NO_TITLE = 128,
    /// Derive width from preferred content measurement.
    AUTO_WIDTH = 256,
    /// Derive height from preferred content measurement.
    AUTO_HEIGHT = 512,
    /// Derive both dimensions from preferred content measurement.
    AUTO_SIZE = 768,
    /// Use the theme-owned outer border and content inset.
    FRAME = 1024,
}

#[version(1)]
/// Immutable copied observation of the manager's authoritative window state.
struct WindowSnapshot {
    /// Current outer screen rectangle.
    rect: Rect,
    /// Current presentation options.
    options: WindowOptions,
    /// Effective visibility including structural ancestors.
    visibility: Visibility,
    /// Fixed, inherited or modal stacking policy.
    layer: WindowLayer,
    /// Parent-owned clipping applied to this window's structural children.
    child_clip: ChildClip,
}

#[version(1)]
/// Logical UI window retained independently of its runtime's tree membership.
interface IWindow {
    /// Copies current authoritative geometry, visibility and policy without caching app-side state.
    fn snapshot(&self) -> Result<WindowSnapshot>;
    /// Returns an immutable UTF-8 title snapshot.
    fn title(&self) -> Result<ComPtr<INcString>>;
    /// Replaces the complete title silently; UTF-8 input offset must be zero.
    fn set_title(&self, title: &[u8]) -> Result<()>;
    /// Changes local visibility intent; ancestors and modal policy determine effective visibility.
    fn set_visibility(&self, visibility: Visibility) -> Result<()>;
    /// Changes concrete presentation options and reconciles capture/disabled descendants.
    fn set_options(&self, options: WindowOptions) -> Result<()>;
    /// Selects a fixed layer in 0..=15; child/dialog layers are manager-controlled.
    fn set_layer(&self, layer: u8) -> Result<()>;
    /// Raises within the permitted structural stacking band.
    fn raise(&self) -> Result<()>;
    /// Changes the clipping applied to structural child windows.
    fn set_child_clip(&self, clip: ChildClip) -> Result<()>;
    /// Changes allocation and schedules layout; negative extents are rejected.
    fn set_rect(&self, rect: Rect) -> Result<()>;
    /// Executes the parent's removal decision synchronously; active descendants reject with Busy.
    /// CloseRequested only reports intent. No runtime queue automatically approves it.
    /// Publishes Destroyed while this runtime continues; delivery errors do not undo removal.
    /// Whole-runtime shutdown instead drops the context without lifecycle notifications.
    fn close(&self) -> Result<()>;
}

#[version(1)]
/// Window policy and topology are owned by the UI runtime object.
interface IWindowManager {
    /// Creates a visible structural child; a modal parent is rejected before claiming the widget.
    fn create_child(
        &self,
        parent: &IWindow,
        title: &[u8],
        rect: Rect,
        root: ComBox<IWidget>, events: &EventBinding) -> Result<ComPtr<IWindow>>;
    /// Creates a hidden modal dialog owned by an ordinary window.
    fn create_dialog(
        &self,
        parent: &IWindow,
        title: &[u8],
        rect: Rect,
        root: ComBox<IWidget>, events: &EventBinding) -> Result<ComPtr<IWindow>>;
    /// Creates a hidden auto-sized popup owned by a live window or dialog.
    fn create_popup(
        &self,
        parent: &IWindow,
        title: &[u8],
        root: ComBox<IWidget>, events: &EventBinding) -> Result<ComPtr<IPopup>>;
    /// Mounts one previously unmounted root and creates its logical window.
    fn create_window(&self, title: &[u8], rect: Rect, root: ComBox<IWidget>, events: &EventBinding) -> Result<ComPtr<IWindow>>;
}

#[version(1)]
/// Runtime-bound authority used to authenticate independently provided node factories.
interface IConstructionHost {
    /// Returns the non-owning widget authority used by independently implemented node classes.
    fn host(&self) -> Result<ComPtr<IWidgetHost>>;
}

#[version(1)]
/// One constructible retained UI with input, rendering, and resource ownership.
interface UiRuntime: IInputSink + IWindowManager + IMenus + IChoiceMenus {
    /// Prepares private compositor resources and installs the client's CPU recording broker.
    /// Host authority is never exposed through widget services. Install before native rendering;
    /// replacement during painting rejects with Busy. Failure preserves the previous binding.
    fn set_render_host(&mut self, host: &IRenderHost) -> Result<()>;

    /// Returns the core construction authority without exposing a concrete nodes factory.
    fn construction_host(&self) -> Result<ComPtr<IConstructionHost>>;

    /// Installs the host clipboard capability before ordinary editing. Replacement affects new
    /// requests; in-flight completions retain authority only while their requesting edit remains current.
    fn set_clipboard(&mut self, clipboard: &ITextClipboard) -> Result<()>;

    /// Retains the currently installed immutable revision, suitable for restoration or another consumer.
    fn assets(&self) -> Result<ComPtr<IAssetBundle>>;
    /// Validates compatible resources and prepares GFX's private atlas before publishing
    /// matching UI metadata. Failure preserves the complete old revision. Identical immutable
    /// images are reused without upload. Success requires update before rendering.
    /// Install after update or event dispatch returns; overlapping calls reject with Busy.
    fn install_assets(&mut self, assets: &IAssetBundle) -> Result<()>;
    /// Drains queued input, or one eventless update, and synchronizes setters/resize without an application event owner.
    fn update(&self, size: Size) -> Result<()>;
    /// Borrows the persistent application owner at safe boundaries; handlers may edit topology before later input.
    /// The runtime never retains this root owner, so it may own the UI without a reference cycle.
    /// Update/render reentry returns BUSY even while the context is available to handlers.
    fn update_with_events(&self, size: Size, owner: &IApplicationDispatcher) -> Result<()>;
    /// Returns the committed editable focus rectangle in drawable coordinates, or None while
    /// geometry/input is pending. Hosts synchronize native IME after each successful update.
    fn text_input_area(&self) -> Result<TextInputArea>;
    /// Paints only after update has synchronized geometry for this drawable size.
    fn render(&self, size: Size, renderer: &IRenderer) -> Result<()>;
    /// Terminates this UI context and synchronously drops all mounted trees and private resources.
    /// Busy preflight leaves the context live; after acceptance no lifecycle notifications are
    /// posted and no pending application messages are dispatched. Settle application requests
    /// before calling; facts already delivered to application queues are not retracted.
    /// Repeated calls succeed. Retained services are closed and weak widgets observe dropped owners.
    fn close(&self) -> Result<()>;
}

#[version(1)]
/// Runtime identity and mutation authority without a reference back to its tree.
interface IWidgetHost {
    /// Posts through the owner's current update/dispatch origin. No scope-control
    /// capability is exposed to widgets. Absence of an active origin rejects the
    /// transfer without losing the event; receiver failures preserve it as well.
    fn post_event(&self, receiver: &IEventReceiver, event: ComBox<IEvent>) -> Result<()>;
    /// Returns the installed clipboard during ordinary mutation, or NotFound for headless hosts.
    fn clipboard(&self) -> Result<ComPtr<ITextClipboard>>;
    /// Retains the current immutable resource revision without owning the runtime tree.
    /// Custom widgets cache bulk metadata by this bundle identity and refresh it during the next
    /// measure/paint after replacement; never retain UVs or glyph metrics across a different revision.
    fn assets(&self) -> Result<ComPtr<IAssetBundle>>;
    /// Creates an empty private child editor; containers expose only its read-only view.
    fn create_children(&self) -> Result<ComBox<IChildrenEditor>>;
    /// Checks lifetime without forbidding observational reads during layout or painting.
    fn check_open(&self) -> Result<()>;
    /// Rejects closed runtimes and mutation during layout or painting.
    fn check_mutation(&self) -> Result<()>;
    /// Conservatively announces possible geometry/routing changes without mutating a widget.
    /// This is required in addition to sticky take_change, including independent C providers.
    /// Legal during observation for failure recovery or marker collection. It rejects only
    /// closed authority; after successful mutation admission it is otherwise infallible.
    /// The runtime drains notifications before scanning all retained trees, including hidden
    /// ones, and retains notifications raised during collection for a later boundary.
    fn mark_geometry_changed(&self) -> Result<()>;
}

#[version(1)]
/// A popup has transient placement and cannot be passed to ordinary window operations.
interface IPopup {
    /// Reports whether this popup belongs to the manager's active visible branch.
    fn visibility(&self) -> Result<Visibility>;
    /// Activates the popup's input scope at the latest consumed pointer position.
    fn show(&mut self) -> Result<()>;
    /// Atomically sets an exact screen anchor and activates the popup's input scope.
    fn show_at(&mut self, anchor: Rect) -> Result<()>;
    /// Dismisses this active branch while preserving the definition for later reuse.
    fn hide(&mut self) -> Result<()>;
    /// Changes popup framing, padding and preferred-size policy.
    fn set_options(&mut self, options: WindowOptions) -> Result<()>;
    /// Permanently removes this popup subtree and drops its widget owners.
    fn close(&mut self) -> Result<()>;
}
