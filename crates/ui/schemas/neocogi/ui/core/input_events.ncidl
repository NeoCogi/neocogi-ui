#[version(1)]
/// One routed input transaction; pointer payloads are already content-local.
enum WidgetEvent: u8 {
    /// Ordinary eventless update, including animation or state synchronization.
    None,
    /// Native focus or capture was lost.
    Cancel,
    /// Pointer motion without held buttons.
    Move {
        /// Current local position.
        position: Point,
        /// Change since the previous queued position.
        delta: Point,
    },
    /// Pointer motion under capture or with held buttons.
    Drag {
        /// Current local position.
        position: Point,
        /// Change since the previous queued position.
        delta: Point,
        /// Held buttons: left=1, right=2, middle=4.
        buttons: u8,
    },
    /// Pointer button press.
    Down {
        /// Local press position.
        position: Point,
        /// Buttons changed by this transition.
        buttons: u8,
    },
    /// Pointer button release.
    Up {
        /// Local release position.
        position: Point,
        /// Buttons changed by this transition.
        buttons: u8,
    },
    /// Wheel or equivalent scrolling input.
    Scroll {
        /// Current local pointer position.
        position: Point,
        /// Requested scroll amount.
        delta: Point,
    },
    /// One complete logical keyboard transition.
    Key(KeyStroke),
    /// The accompanying bounded UTF-8 argument carries the complete committed text.
    Text,
}

#[version(1)]
/// Router-owned geometry and interaction snapshot for one widget update.
struct WidgetUpdate {
    /// Whether pointer hit tests belong to the currently hovered logical root.
    in_hover_root: bool,
    /// Content allocation with local origin (0, 0).
    rect: Rect,
    /// Effective content-local clip.
    clip: Rect,
    /// Content allocation in native drawable coordinates, for input-method placement.
    screen: Rect,
    /// Pointer currently hovers this surface.
    hovered: bool,
    /// This surface owns logical keyboard focus.
    focused: bool,
    /// An eligible primary-button press selected this surface in this transaction.
    clicked: bool,
    /// This surface owns pointer capture while the primary button is held.
    active: bool,
    /// Shared action derived from the routed event and declared keyboard capabilities.
    action: WidgetAction,
    /// Current held mouse buttons using the same bits as pointer event payloads.
    mouse_buttons: u8,
    /// Complete current modifier snapshot using KeyStroke's bit assignments.
    modifiers: u8,
}

#[version(1)]
/// Shared semantic keyboard/pointer action resolved by the runtime's routing rules.
    enum WidgetAction: u8 {
        /// No semantic action was requested.
        None = 0,
        /// Invoke the primary command.
        Activate = 1,
        /// Move one step toward the lower value.
        Decrease = 2,
        /// Move one step toward the higher value.
        Increase = 3,
        /// Reveal a hierarchical branch or popup.
        Expand = 4,
        /// Hide a hierarchical branch or popup.
        Collapse = 5,
    }

#[version(1)]
/// Presentation of a lexical file selection; the application validates existence and replacement policy.
enum FileDialogMode: u8 {
    /// Select an existing input file, displaying an Open action.
    Open,
    /// Select a destination, displaying a Save action.
    Save,
}

#[version(1)]
/// Public editing capability of the nodes-provider file picker composite.
/// The provider mounts the same object through IWidget/IContainerLayout; this
/// capability controls its modal request and does not grant a second attachment.
/// Retaining the picker does not keep its allocating runtime open.
interface IFileDialog {
    /// Returns the actual stable modal window capability for ordinary lifecycle and geometry operations.
    fn window(&self) -> Result<ComPtr<IWindow>>;
    /// Reads and validates a complete native directory before changing request state or showing the modal.
    fn open(&mut self, title: &[u8], rect: Rect, directory: &INativePath, mode: FileDialogMode, filename: &INativePath) -> Result<()>;
    /// Reports whether a request is active; hidden/idle is distinct from permanently closed.
    fn active(&self) -> Result<bool>;
    /// Cancels one active request and hides its reusable modal; idle cancellation returns false.
    fn cancel(&mut self) -> Result<bool>;
    /// Copies the latest failed directory-read diagnostic without replacing the previous valid listing.
    fn diagnostic(&self) -> Result<ComPtr<INcString>>;

}

#[version(1)]
/// Standard picker construction capability exposed by a nodes interface bound to window management.
interface IFileDialogs {
    /// Creates one hidden reusable modal owned by the authenticated ordinary window.
    fn create(&self, parent: &IWindow, events: &EventBinding) -> Result<WeakComBox<IFileDialog>>;
}
