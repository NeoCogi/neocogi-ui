#[version(1)]
/// Explicit fractional UI input: finite, within +/-131072 pixels, rounded once to 1/64 pixel.
struct PaintPoint {
    /// Horizontal widget-local coordinate in pixels.
    x: f32,
    /// Vertical widget-local coordinate in pixels.
    y: f32,
}

#[version(1)]
/// Fractional UI vertex admitted into checked fixed-point geometry; UV-free solid color input.
struct ColoredVertex {
    /// Horizontal widget-local position in pixels.
    x: f32,
    /// Vertical widget-local position in pixels.
    y: f32,
    /// Red in the least significant byte, then green, blue and alpha.
    rgba: u32,
}
