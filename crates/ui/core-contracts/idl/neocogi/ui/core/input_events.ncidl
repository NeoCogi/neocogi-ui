#[version(1)]
/// One routed input transaction; pointer payloads are already content-local.
enum WidgetEvent: u8 {
    /// Ordinary eventless update, including animation or state synchronization.
    None,
    /// Native focus or capture was lost.
    Cancel,
    /// Pointer motion without held buttons.
    Move {
        /// Current local position.
        position: Point,
        /// Change since the previous queued position.
        delta: Point,
    },
    /// Pointer motion under capture or with held buttons.
    Drag {
        /// Current local position.
        position: Point,
        /// Change since the previous queued position.
        delta: Point,
        /// Held buttons: left=1, right=2, middle=4.
        buttons: u8,
    },
    /// Pointer button press.
    Down {
        /// Local press position.
        position: Point,
        /// Buttons changed by this transition.
        buttons: u8,
    },
    /// Pointer button release.
    Up {
        /// Local release position.
        position: Point,
        /// Buttons changed by this transition.
        buttons: u8,
    },
    /// Wheel or equivalent scrolling input.
    Scroll {
        /// Current local pointer position.
        position: Point,
        /// Requested scroll amount.
        delta: Point,
    },
    /// One complete logical keyboard transition.
    Key(KeyStroke),
    /// The accompanying bounded UTF-8 argument carries the complete committed text.
    Text,
}

#[version(1)]
/// Router-owned geometry and interaction snapshot for one widget update.
struct WidgetUpdate {
    /// Whether pointer hit tests belong to the currently hovered logical root.
    in_hover_root: bool,
    /// Content allocation with local origin (0, 0).
    rect: Rect,
    /// Effective content-local clip.
    clip: Rect,
    /// Content allocation in native drawable coordinates, for input-method placement.
    screen: Rect,
    /// Pointer currently hovers this surface.
    hovered: bool,
    /// This surface owns logical keyboard focus.
    focused: bool,
    /// An eligible primary-button press selected this surface in this transaction.
    clicked: bool,
    /// This surface owns pointer capture while the primary button is held.
    active: bool,
    /// Shared action derived from the routed event and declared keyboard capabilities.
    action: WidgetAction,
    /// Current held mouse buttons using the same bits as pointer event payloads.
    mouse_buttons: u8,
    /// Complete current modifier snapshot using KeyStroke's bit assignments.
    modifiers: u8,
}

#[version(1)]
/// Shared semantic keyboard/pointer action resolved by the runtime's routing rules.
    enum WidgetAction: u8 {
        /// No semantic action was requested.
        None = 0,
        /// Invoke the primary command.
        Activate = 1,
        /// Move one step toward the lower value.
        Decrease = 2,
        /// Move one step toward the higher value.
        Increase = 3,
        /// Reveal a hierarchical branch or popup.
        Expand = 4,
        /// Hide a hierarchical branch or popup.
        Collapse = 5,
    }

#[version(1)]
/// Concrete labelled activation consumer shared by Button, ListItem and ListBox.
event IActivationSink {
    /// Receives an immutable submission snapshot after widget traversal releases its borrows.
    fn submitted(&mut self, label: &str) -> Result<()>;
}

#[version(1)]
/// Shared labelled activation source; the producer never owns the returned lease or its sink.
interface IActivationEvents {
    /// Connects the exclusive subscriber and returns its ownership lease.
    port: IActivationSink;
}

#[version(1)]
/// Complete normalized text and scalar-aligned UTF-8 byte cursor at the moment of a user edit.
event ITextChangedSink {
    /// Receives an owned immutable text capability borrowed only for this synchronous delivery.
    fn changed(&mut self, text: &str, cursor: u64) -> Result<()>;
}

#[version(1)]
/// Complete normalized text at submission, independent of later edits.
event ITextSubmittedSink {
    /// Receives the already captured submission value after traversal.
    fn submitted(&mut self, text: &str) -> Result<()>;
}

#[version(1)]
/// Shared editor event family; changed and submitted are independent exclusive ports.
interface ITextEvents {
    /// Connects one changed consumer without claiming the separate submitted port.
    port changed: ITextChangedSink;
    /// Connects one submitted consumer without claiming the separate changed port.
    port submitted: ITextSubmittedSink;
}

#[version(1)]
/// Captured window lifecycle or user chrome interaction; Destroyed is the one terminal fact.
enum WindowEvent: u8 {
    /// A user move or resize committed this complete outer rectangle.
    GeometryChanged {
        /// Captured outer geometry, independent of subsequent window edits.
        rect: Rect,
    },
    /// The user activated the close affordance; the application decides whether to close.
    CloseRequested,
    /// Visibility became false; later callback code may observe a subsequent show.
    Hidden,
    /// The window and its descendants were logically destroyed; delivered once after producer closure.
    Destroyed,
    /// The user minimized to this complete compact rectangle.
    Minimized {
        /// Captured compact outer geometry.
        rect: Rect,
    },
    /// The user maximized into this inherited viewport rectangle.
    Maximized {
        /// Captured maximized outer geometry.
        rect: Rect,
    },
    /// The user restored this previously saved rectangle.
    Restored {
        /// Captured restored outer geometry.
        rect: Rect,
    },
}

#[version(1)]
/// Concrete consumer of copied window events, including the terminal Destroyed fact.
event IWindowSink {
    /// Receives the exact committed lifecycle/chrome snapshot after the manager releases traversal ownership.
    fn event(&mut self, event: WindowEvent) -> Result<()>;
}

#[version(1)]
/// Subscription capability on the actual logical window object; the manager owns its existing native source.
interface IWindowEvents {
    /// Connects the current source without making a retained window reference prolong native tree ownership.
    port: IWindowSink;
}

#[version(1)]
/// Concrete consumer of ordinary popup dismissal; destruction does not fabricate replay history.
event IPopupSink {
    /// Reports removal from the active popup branch, independently of later activation.
    fn dismissed(&mut self) -> Result<()>;
}

#[version(1)]
/// Subscription capability on the actual popup object and its existing manager-owned source.
interface IPopupEvents {
    /// Returns an exclusive application-owned dismissal lease without retaining application state on the producer.
    port: IPopupSink;
}

#[version(1)]
/// Concrete terminal outcome of one request; there is no impossible Pending event variant.
event IFileDialogSink {
    /// Accepts an exact native path independently of its potentially lossy filename label.
    fn accepted(&mut self, path: &INativePath) -> Result<()>;
    /// Reports explicit cancellation, hiding, close affordance or destruction of an active request.
    fn cancelled(&mut self) -> Result<()>;
}

#[version(1)]
/// Optional event-driving capability on any mounted UI component.
/// It yields a separate COM allocation, so callback edits never reenter the
/// mounted widget's object-wide call gate through the driver itself.
interface IComponentEventProvider {
    /// Returns the component-owned private dispatcher used before application dispatch.
    /// The dispatcher must have a distinct IUnknown identity from this widget.
    fn private_dispatcher(&self) -> Result<IEventDispatcher>;
}

#[version(1)]
/// Independent completion source for this reusable picker, using the shared application-owned lease transport.
interface IFileDialogEvents {
    /// Connects one concrete completion consumer without retaining the application on the producer.
    port: IFileDialogSink;
}

#[version(1)]
/// Nodes-provider file picker controller and real COM controls; retaining it does not keep its runtime open.
interface IFileDialog {
    /// Returns the actual stable modal window capability for ordinary lifecycle and geometry operations.
    fn window(&self) -> Result<IWindow>;
    /// Reads and validates a complete native directory before changing request state or showing the modal.
    fn open(&self, title: &[u8], rect: Rect, directory: &INativePath) -> Result<()>;
    /// Reports whether a request is active; hidden/idle is distinct from permanently closed.
    fn active(&self) -> Result<bool>;
    /// Cancels one active request and hides its reusable modal; idle cancellation returns false.
    fn cancel(&self) -> Result<bool>;
    /// Permanently destroys the modal and ends its active request, while retained handles remain safe.
    fn close(&self) -> Result<()>;
    /// Copies the latest failed directory-read diagnostic without replacing the previous valid listing.
    fn diagnostic(&self) -> Result<String>;
}

#[version(1)]
/// Standard picker construction capability exposed by a nodes factory bound to window management.
interface IFileDialogs {
    /// Creates one hidden reusable modal owned by the authenticated ordinary window.
    fn create(&self, parent: &IWindow) -> Result<IFileDialog>;
}
