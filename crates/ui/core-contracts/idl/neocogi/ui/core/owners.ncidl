#[version(1)]
/// Persistent owned behavior shared by applications and mounted composites.
interface IEventOwner {
    /// Claims the view and controller together; repeated attachment is rejected.
    /// The controller must check its own eligibility before calling view.mount,
    /// then commit its state only after that call succeeds. The runtime validates
    /// all other mount inputs before invoking this final attachment operation.
    fn mount(&mut self, view: &IWidget) -> Result<()>;
    /// Handles at most one queued message after widget and traversal borrows end.
    /// False means idle; handler errors consume only the attempted message.
    fn dispatch_next(&mut self) -> Result<bool>;
    /// Closes the inbox and settles terminal outcomes once. Retained handles may
    /// outlive retirement, but may not resume delivery or attach elsewhere.
    fn retire(&mut self) -> Result<()>;
}

#[version(1)]
#[message]
/// Explicit content for one irreversible tree attachment; no forwarding widget is needed.
enum Mount: u8 {
    /// A widget whose outputs are bound directly to an enclosing owner.
    Widget {
        /// Actual view mounted and closed by the runtime.
        view: IWidget,
    },
    /// A composed view and its separately owned behavior share one mount lifetime.
    Component {
        /// Actual view; it never retains the controller through this relationship.
        view: IWidget,
        /// Persistent controller retained by the mount and retired after active dispatch returns.
        owner: IEventOwner,
    },
}
