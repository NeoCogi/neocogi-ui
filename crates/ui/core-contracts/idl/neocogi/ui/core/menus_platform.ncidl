#[version(1)]
/// Persistent menu marker role remains present even when its selected boolean is false.
enum MenuMark: u8 {
    /// No marker role or required marker gutter.
    None,
    /// Checkable item whose boolean determines check-glyph visibility.
    Checked {
        /// Current presentation state; submission does not toggle it automatically.
        checked: bool,
    },
    /// Radio item whose boolean determines selection-marker visibility.
    Radio {
        /// Current presentation state; application code owns radio-group policy.
        selected: bool,
    },
}

#[version(1)]
/// Checked byte range for one choice or branch label in an operation's shared UTF-8 buffer.
struct MenuTextRange {
    /// First byte of the label in the shared text buffer.
    first: u32,
    /// Number of UTF-8 bytes in the label, without a terminator.
    count: u32,
}

#[version(1)]
/// One preorder entry in a selection-oriented menu; nesting beyond 32 branches is rejected.
enum ChoiceMenuEntry: u8 {
    /// Selectable leaf identified independently from its label or tree position.
    Choice {
        /// Stable application-defined identity returned by the owning selection control.
        id: u64,
        /// Checked UTF-8 label range in the operation's shared text buffer.
        label: MenuTextRange,
    },
    /// Nonempty branch followed immediately by exactly `children` direct preorder entries.
    Submenu {
        /// Checked UTF-8 branch label range in the operation's shared text buffer.
        label: MenuTextRange,
        /// Positive number of direct children; nested descendants follow their owning child branch.
        children: u32,
    },
}

#[version(1)]
/// Optional committed selection for a choice menu, with no reserved in-band identity.
enum ChoiceSelection: u8 {
    /// No leaf is committed.
    None,
    /// One application-defined leaf identity is committed.
    Selected(u64),
}

#[version(2)]
/// Live selection-oriented menu owned by the core popup manager.
///
/// The menu owns hierarchy, navigation, placement and committed selection. A header control such
/// as Combo owns only its presentation and delegates these menu responsibilities through this
/// interface. Mutations are silent; only user submission publishes `ChoiceSelection`.
class IChoiceMenu {
    /// Returns the exact committed stable identity, including explicit absence.
    fn selection(&self) -> Result<ChoiceSelection>;
    /// Copies the selected leaf label, or an empty string when no leaf is committed.
    fn selected_label(&self) -> Result<ComPtr<INcString>>;
    /// Returns the number of selectable leaves across the complete hierarchy.
    fn choice_count(&self) -> Result<u64>;
    /// Copies one leaf label in preorder; an out-of-range ordinal is rejected.
    fn choice_label(&self, ordinal: u64) -> Result<ComPtr<INcString>>;
    /// Atomically replaces the complete hierarchy and optional selection after validating both.
    fn replace(&mut self, menu_text: &[u8], entries: &[ChoiceMenuEntry], selection: ChoiceSelection) -> Result<()>;
    /// Silently changes the committed selection; an unknown identity is rejected.
    fn set_selection(&mut self, selection: ChoiceSelection) -> Result<()>;
    /// Requests activation below an exact screen-space anchor after the current traversal phase.
    fn show_at(&mut self, anchor: Rect) -> Result<()>;
    /// Requests dismissal after the current traversal phase while retaining the menu definition.
    fn hide(&mut self) -> Result<()>;
    /// Requests activation or dismissal according to the menu's current reconciled intent.
    fn toggle_at(&mut self, anchor: Rect) -> Result<()>;

    /// Permanently retires the private popup and ends event delivery.
    fn close(&mut self) -> Result<()>;
}

#[version(2)]
/// Construction capability for selection menus managed by the core popup forest.
interface IChoiceMenus {
    /// Creates one validated hidden choice hierarchy owned by an authenticated ordinary window.
    fn create_choice_menu(
        &self,
        parent: &IWindow,
        menu_text: &[u8],
        entries: &[ChoiceMenuEntry],
        selection: ChoiceSelection, events: &EventBinding<IChoiceMenuEvent>) -> Result<ComPtr<IChoiceMenu>>;
}

#[version(1)]
/// Live compact row capability, editable before mounting and while its owning surface exists.
interface IMenuItem {
    /// Returns the same label used by measurement, paint and captured submissions.
    fn label(&self) -> Result<ComPtr<INcString>>;
    /// Replaces complete UTF-8 display text without publishing user activation.
    fn set_label(&self, label: &[u8]) -> Result<()>;
    /// Reports pointer and keyboard eligibility, independently of marker presentation.
    fn enabled(&self) -> Result<bool>;
    /// Silently changes interaction eligibility; disabled rows remain visible.
    fn set_enabled(&self, enabled: bool) -> Result<()>;
    /// Returns the concrete check/radio role and its current presentation state.
    fn mark(&self) -> Result<MenuMark>;
    /// Silently changes the complete marker role; radio grouping remains the caller's responsibility.
    fn set_mark(&self, mark: MenuMark) -> Result<()>;
    /// Returns presentation-only accelerator text, with empty text representing absence.
    fn shortcut_hint(&self) -> Result<ComPtr<INcString>>;
    /// Changes presentation only; it does not install a keyboard shortcut handler.
    fn set_shortcut_hint(&self, hint: &[u8]) -> Result<()>;
}

#[version(1)]
/// Unique declaration tree consumed once by the owning manager; retained item capabilities remain live afterward.
interface IMenuBuilder {
    /// Appends an enabled unmarked row and returns its editing/event capability.
    fn item(&self, label: &[u8], events: &EventBinding<Activation>) -> Result<ComPtr<IMenuItem>>;
    /// Appends one noninteractive separator in exact declaration order.
    fn separator(&self) -> Result<()>;
    /// Appends a submenu and returns a builder scoped to that child; only the root is mountable.
    fn submenu(&self, label: &[u8]) -> Result<ComPtr<IMenuBuilder>>;
}

#[version(1)]
/// Menu construction and attachment capability on the same runtime identity as the window manager.
interface IMenus {
    /// Creates one root declaration; for a bar its direct entries must all be submenus.
    fn create(&self, label: &[u8]) -> Result<ComPtr<IMenuBuilder>>;
    /// Installs a bar once on a live window; validates owner, declaration shape and prior attachment before transfer.
    fn attach_bar(&self, window: &IWindow, menu: &IMenuBuilder) -> Result<()>;
    /// Creates an ordinary hidden popup from one root declaration, including all its nested menus.
    fn create_popup(&self, window: &IWindow, menu: &IMenuBuilder, events: &EventBinding<PopupDismissed>) -> Result<ComPtr<IPopup>>;
}

#[version(1)]
/// Complete typed event stream of IChoiceMenu; consumed by its behavioral parent.
enum IChoiceMenuEvent {
    /// Captured changed fact, acquired before the producer call returns.
    Changed(ChoiceSelection),
}
