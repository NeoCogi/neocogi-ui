#[version(1)]
/// User checkbox state; programmatic setters do not publish it.
struct CheckboxChanged {
    /// Committed checked state.
    checked: bool,
}

#[version(1)]
/// Finite user value shared by Slider and Number.
struct NumericChanged {
    /// Committed finite numeric value.
    value: f32,
}

#[version(1)]
/// Clamped scrollbar offset committed by pointer input.
struct ScrollbarChanged {
    /// Committed nonnegative offset.
    offset: i32,
}

#[version(1)]
/// First-pane extent committed by direct divider interaction.
struct SplitChanged {
    /// Nonnegative pixel position after clamping against the current pane limits.
    position: i32,
}
