/// Process entry factory for optional asset construction services.
#[version(1)]
factory AssetsPluginFactory {
    /// Creates the PNG upload service.
    fn png_decoder(&self) -> Result<PngDecoder>;
    /// Creates the style derivation service.
    fn style_compiler(&self) -> Result<StyleCompiler>;
    /// Creates the optional atlas builder service.
    fn asset_loader(&self) -> Result<AssetLoader>;
    /// Creates the optional JSON theme loader service.
    fn theme_loader(&self) -> Result<ThemeLoader>;
}
