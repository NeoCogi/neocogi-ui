    /// Commits an actual popup selection, closes the header, and emits changed only when index or label differs.
    fn submit_selection(&mut self, index: u64, label: &[u8]) -> Result<()>;
    /// Selects a semantic font role and invalidates measurement only when it differs.
    fn set_font_role(&mut self, role: FontRole) -> Result<()>;
    /// Resolves an exact named font in the current host bundle before committing.
    fn set_named_font(&mut self, name: &[u8]) -> Result<()>;
    /// Connects the independent captured-selection subscriber.
    fn subscribe_changed(&mut self, sink: &IComboChangedSink) -> Result<IEventSubscription>;
    /// Connects the independent popup-coordination subscriber.
    fn subscribe_popup(&mut self, sink: &IComboPopupSink) -> Result<IEventSubscription>;
}

#[version(1)]
/// Checked contiguous range in a bundle's name bytes or glyph records.
struct AssetRange {
    /// First byte or record; arithmetic is checked before indexing.
    first: u32,
    /// Number of bytes or records, without a terminator.
    count: u32,
}

#[version(1)]
/// Allocation bounds read before copying any variable-length table.
struct AssetInfo {
    /// Exact ASSET_SCHEMA_VERSION; reject stale semantic table layouts before allocation.
    schema: u32,
    /// Positive atlas dimensions, with exactly width * height * 4 RGBA bytes.
    size: Size,
    /// Number of font records, bounded by MAX_ASSET_FONTS.
    fonts: u32,
    /// Number of icon records, bounded by MAX_ASSET_ICONS.
    icons: u32,
    /// Number of glyph records, bounded by MAX_ASSET_GLYPHS.
    glyphs: u32,
    /// Combined UTF-8 name storage, bounded by MAX_ASSET_NAMES.
    names: u32,
}

#[version(1)]
/// Font metrics and an exact partition of the bulk glyph table.
struct AssetFont {
    /// Nonempty UTF-8 font name, unique among fonts in this catalog.
    name: AssetRange,
    /// Contiguous glyph records; fonts partition the table in declaration order.
    glyphs: AssetRange,
    /// Positive distance between text baselines in pixels.
    line_size: i32,
    /// Baseline offset from the top of the line.
    baseline: i32,
    /// Positive requested pixel size used to construct this font.
    font_size: i32,
}

#[version(1)]
/// One Unicode scalar's immutable measurement and texture coordinates.
struct AssetGlyph {
    /// Valid Unicode scalar; duplicate characters in a font are rejected.
    scalar: u32,
    /// Horizontal offset from the text cursor in pixels.
    offset_x: i32,
    /// Vertical offset from the text cursor in pixels.
    offset_y: i32,
    /// Horizontal cursor advance in pixels.
    advance_x: i32,
    /// Vertical cursor advance in pixels.
    advance_y: i32,
    /// Nonnegative rectangle wholly inside the atlas; empty glyphs are permitted.
    rect: Rect,
}

#[version(1)]
/// A named positive atlas rectangle; the required white icon must be opaque white.
struct AssetIcon {
    /// Nonempty UTF-8 name, unique among icons in this catalog.
    name: AssetRange,
    /// Positive rectangle wholly inside the atlas.
    rect: Rect,
}

#[version(1)]
/// Structural surface role whose table entries vary only by availability.
    enum SurfaceRole: u8 {
        /// Window or modal-dialog background below application content and chrome.
        WINDOW = 0,
        /// Generic frame requested through the common FRAME widget option.
        GENERIC_FRAME = 1,
        /// Content panel or scroll-area viewport background.
        PANEL = 2,
    }

#[version(1)]
/// Interactive control part sharing pointer and keyboard-focus behavior.
    enum ControlRole: u8 {
        /// Ordinary command button or button-like list box.
        BUTTON = 0,
        /// Checkbox square; checked state is painted independently.
        CHECKBOX = 1,
        /// Single-line, multiline, or numeric text input background.
        TEXT_INPUT = 2,
        /// Generic item or tree row whose state supplies transient selection.
        ITEM = 3,
        /// Combo-box header.
        COMBO = 4,
        /// Slider background track.
        SLIDER_TRACK = 5,
        /// Slider value thumb.
        SLIDER_THUMB = 6,
        /// Scrollbar background track.
        SCROLLBAR_TRACK = 7,
        /// Scrollbar movable thumb.
        SCROLLBAR_THUMB = 8,
        /// Window close caption button.
        CLOSE_BUTTON = 9,
        /// Window minimize caption button.
        MINIMIZE_BUTTON = 10,
        /// Window maximize caption button.
        MAXIMIZE_BUTTON = 11,
        /// Window restore caption button used while maximized.
        RESTORE_BUTTON = 12,
        /// Visible bottom-right resize grip.
        RESIZE_GRIP = 13,
    }

#[version(1)]
/// Menu-owned surface or entry role with menu-specific open-selection behavior.
    enum MenuRole: u8 {
        /// Menu bar spanning a window.
        BAR = 0,
        /// Menu-bar title which can own an open popup.
        TITLE = 1,
        /// Popup-menu panel.
        POPUP = 2,
        /// Ordinary menu item or submenu row.
        ITEM = 3,
    }

#[version(1)]
/// Manager-owned window chrome role whose presentation follows activation.
    enum ChromeRole: u8 {
        /// Ordinary-window outer frame decoration.
        WINDOW_FRAME = 0,
        /// Modal-dialog outer frame decoration.
        DIALOG_FRAME = 1,
        /// Window title patch and semantic-content color.
        TITLE = 2,
    }

#[version(1)]
/// Pointer interaction nested inside an enabled control state.
    enum PointerState: u8 {
        /// Pointer is not hovering or pressing the control.
        NORMAL = 0,
        /// Pointer is hovering the control without an active press.
        HOVERED = 1,
        /// Pointer capture is pressed while the pointer remains over the control.
        PRESSED = 2,
    }

#[version(1)]
/// State of an interactive control, excluding impossible disabled interaction combinations.
enum ControlState: u8 {
    /// Control is unavailable; pointer and keyboard-focus presentation do not apply.
    Disabled,
    /// Control is available without keyboard focus and has the enclosed pointer state.
    Enabled(PointerState),
    /// Control owns visible keyboard focus and has the enclosed pointer state.
    Focused(PointerState),
}

#[version(1)]
/// Availability state of a noninteractive structural surface.
    enum SurfaceState: u8 {
        /// Surface belongs to an enabled retained subtree.
        NORMAL = 0,
        /// Surface belongs to a disabled retained subtree.
        DISABLED = 1,
    }

#[version(1)]
/// State of a menu surface or entry after menu-specific precedence is resolved.
    enum MenuState: u8 {
        /// Enabled entry or surface without transient selection.
        NORMAL = 0,
        /// Pointer is over an enabled entry.
        HOVERED = 1,
        /// Pointer capture is pressed over an enabled entry.
        PRESSED = 2,
        /// Keyboard navigation selected an enabled entry.
        FOCUSED = 3,
        /// Entry owns the popup currently open beneath it.
        OPEN = 4,
        /// Entry or surface is unavailable.
        DISABLED = 5,
    }

#[version(1)]
/// State of manager-owned chrome after activation and availability are resolved.
    enum ChromeState: u8 {
        /// Enabled chrome for a window that does not own activation.
        BASE = 0,
        /// Enabled chrome for the active window.
        ACTIVE = 1,
        /// Chrome belonging to a disabled window.
        DISABLED = 2,
    }

#[version(1)]
/// Semantic icon role required in every complete UI asset bundle.
    enum IconRole: u8 {
        /// Window and dialog close affordance.
        CLOSE = 0,
        /// Collapsed disclosure affordance.
        EXPAND = 1,
        /// Expanded disclosure affordance.
        COLLAPSE = 2,
        /// Checked checkbox and menu-item mark.
        CHECK = 3,
        /// Combo-box dropdown affordance.
        EXPAND_DOWN = 4,
        /// Open-folder file-dialog item.
        OPEN_FOLDER = 5,
        /// Closed-folder file-dialog item.
        CLOSED_FOLDER = 6,
        /// Regular file-dialog item.
        FILE = 7,
    }

#[version(1)]
/// Four nonnegative pixel insets used by resolved theme geometry.
#[deserialize]
struct Insets {
    /// Leading horizontal thickness.
    left: i32,
    /// Leading vertical thickness.
    top: i32,
    /// Trailing horizontal thickness.
    right: i32,
    /// Trailing vertical thickness.
    bottom: i32,
}

#[version(1)]
/// Complete scalar layout recipe; installation rejects negative dimensions.
#[deserialize(default)]
struct AssetMetrics {
    /// Preferred width when a layout supplies none.
    default_cell_width: i32,
    /// Inner control padding.
    padding: i32,
    /// Window body padding independent of controls.
    window_content_insets: Insets,
    /// Distance between neighboring cells.
    spacing: i32,
    /// Nested content indentation.
    indent: i32,
    /// Window title height.
    title_height: i32,
    /// Structural top-level border thickness.
    window_border: Insets,
    /// Scrollbar transverse size.
    scrollbar_size: i32,
    /// Minimum scrollbar and slider thumb size.
    thumb_size: i32,
}

#[version(1)]
/// Window title placement within the available caption geometry.
    enum TitleAlignment: u8 {
        /// Start at the leading edge.
        LEADING = 0,
        /// Center within the title, reserving symmetric caption banks.
        CENTERED = 1,
    }

#[version(1)]
/// Caption bank containing one window control.
    enum CaptionSide: u8 {
        /// Place in the leading bank.
        LEADING = 0,
        /// Place in the trailing bank.
        TRAILING = 1,
    }

#[version(1)]
/// Complete caption and title geometry; boolean fields accept only zero or one.
struct AssetChrome {
    /// Leading or centered title placement.
    title_alignment: TitleAlignment,
    /// Leading or trailing close button bank.
    close_side: CaptionSide,
    /// Leading or trailing minimize button bank.
    minimize_side: CaptionSide,
    /// Leading or trailing maximize button bank.
    maximize_side: CaptionSide,
    /// Pixels above and below square captions.
    vertical_spacing: i32,
    /// Minimum caption extent.
    minimum_extent: i32,
    /// Gap between title and nonempty caption banks.
    inner_spacing: i32,
    /// Whether inactive captions remain visible and hittable, zero or one.
    show_without_activation: u8,
    /// Body height retained when minimized.
    minimized_content_height: i32,
    /// Whether the active title has a flat backdrop, zero or one.
    has_backdrop: u8,
    /// Backdrop color, packed R | G<<8 | B<<16 | A<<24.
    backdrop_rgba: u32,
    /// Additional pixels on each side of backdrop text.
    backdrop_padding: i32,
}

#[version(1)]
/// Resolved nine-patch artwork; colors use the renderer's packed RGBA convention.
enum AssetPatch: u8 {
    /// Nine independent cells; alpha zero means no visible cell.
    Flat {
        /// Top-left corner color.
        top_left: u32,
        /// Top edge color.
        top: u32,
        /// Top-right corner color.
        top_right: u32,
        /// Left edge color.
        left: u32,
        /// Center color.
        center: u32,
        /// Right edge color.
        right: u32,
        /// Bottom-left corner color.
        bottom_left: u32,
        /// Bottom edge color.
        bottom: u32,
        /// Bottom-right corner color.
        bottom_right: u32,
    },
    /// One bundle-local icon sliced into nine source cells.
    Image {
        /// Index in this bundle's icon table, never a native texture handle.
        icon: u32,
        /// Source-space slicing thickness.
        source: Insets,
        /// Color modulation applied to every sampled cell.
        tint: u32,
    },
}

#[version(1)]
/// One resolved state value; geometry and content color are transferred together.
struct AssetVisual {
    /// Destination-space slicing thickness.
    insets: Insets,
    /// Whether to include the stretchable center, zero or one.
    center_visible: u8,
    /// Text and semantic-icon color in packed RGBA order.
    content_color: u32,
    /// Validated flat cells or a bundle-local image reference.
    patch: AssetPatch,
}

#[version(1)]
/// Family whose table is role-major, then state-major, using the declared role/state order.
    enum AppearanceFamily: u8 {
        /// SurfaceRole × SurfaceState values.
        SURFACE = 0,
        /// ControlRole × ControlState values.
        CONTROL = 1,
        /// MenuRole × MenuState values.
        MENU = 2,
        /// ChromeRole × ChromeState values.
        CHROME = 3,
    }

#[version(1)]
/// Logical resource namespace authenticated by canonical COM identity.
/// Derived bundles retain this capability and preserve the meaning of existing names.
/// Independently created catalogs remain unrelated even when their names match.
trait IAssetCatalog {}

#[version(1)]
/// Immutable, self-contained resource revision. Every copy writes the exact requested range.
/// Names partition their byte table in font-then-icon order. Fonts require an underscore
/// fallback; body and the standard semantic icon names are mandatory. Consumers import
/// once, validating all records and pixels before publication. No per-glyph COM calls occur.
trait IAssetBundle {
    /// Retains the logical namespace shared by compatible derived revisions.
    fn catalog(&self) -> Result<IAssetCatalog>;
    /// Returns bounded allocation counts and dimensions.
    fn info(&self) -> Result<AssetInfo>;
    /// Copies tightly packed RGBA bytes in row-major order.
    fn pixels(&self, output: &mut [u8]) -> Result<()>;
    /// Copies contiguous font records.
    fn fonts(&self, output: &mut [AssetFont]) -> Result<()>;
    /// Copies contiguous glyph records.
    fn glyphs(&self, output: &mut [AssetGlyph]) -> Result<()>;
    /// Copies contiguous icon records.
    fn icons(&self, output: &mut [AssetIcon]) -> Result<()>;
    /// Copies the exact UTF-8 name pool without NUL terminators.
    fn names(&self, output: &mut [u8]) -> Result<()>;
    /// Returns complete scalar layout metrics.
    fn metrics(&self) -> Result<AssetMetrics>;
    /// Returns complete window chrome policy.
    fn chrome(&self) -> Result<AssetChrome>;
    /// Copies one complete resolved appearance family in the documented fixed order.
    fn visuals(&self, family: AppearanceFamily, output: &mut [AssetVisual]) -> Result<()>;
}

#[version(1)]
/// Optional native font/PNG construction session; all mutation uses concrete named operations.
trait IAssetBuilder {
    /// Adds a PNG icon under a distinct UTF-8 name and exact native path; byte offset is zero.
    fn add_icon(&self, name: &[u8], path: &INativePath) -> Result<()>;
    /// Adds a distinct font name at a positive pixel size; the native builder bakes printable ASCII.
    fn add_font(&self, name: &[u8], path: &INativePath, pixels: u32) -> Result<()>;
    /// Consumes the session even on validation failure. A successful result has all required
    /// semantic resources and the ordinary immutable bundle form; nested operations return BUSY.
    fn finish(&self) -> Result<IAssetBundle>;
}

#[version(1)]
/// Constructible optional CPU asset root; UI and hosts need no linked font or PNG implementation.
factory AssetLoader: IAssetDiagnostics {
    /// Starts a fresh atlas using an opaque-white PNG tile; dimensions are validated before reading files.
    fn create_builder(&self, size: Size, white: &INativePath) -> Result<IAssetBuilder>;
    /// Copies an existing bundle into a new packing area while retaining its catalog namespace.
    fn derive_builder(&self, size: Size, base: &IAssetBundle) -> Result<IAssetBuilder>;
}

#[version(1)]
/// Owned diagnostic snapshots supplement recoverable asset-operation statuses.
trait IAssetDiagnostics {
    /// Returns the latest recorded native/decoder/compiler cause, initially empty; argument validation may add no detail.
    fn diagnostic(&self) -> Result<String>;
}

#[version(1)]
/// Constructible optional JSON/font/PNG root producing ordinary immutable bundles.
factory ThemeLoader: IAssetDiagnostics {
    /// Resolves a native theme path against the base's catalog, preserving original resource names.
    fn load_theme(&self, path: &INativePath, base: &IAssetBundle) -> Result<IAssetBundle>;
}

#[version(1)]
/// Explicit choice between preserving authored artwork and replacing it with a flat recipe.
enum PaletteEdit: u8 {
    /// Keep the current role/state visuals, including image-backed theme artwork.
    Preserve,
    /// Compile this complete named palette through the UI's shared flat-style rules.
    Flat(FlatPalette),
}

#[version(1)]
/// Constructible asset authoring root independent of UI trees and renderer resources.
factory StyleCompiler: IAssetDiagnostics {
    /// Derives a complete immutable revision in the base catalog without installing it.
    /// Preserve retains artwork; Flat recompiles every appearance from one concrete palette.
    fn derive_style(&self, base: &IAssetBundle, metrics: AssetMetrics, palette: PaletteEdit) -> Result<IAssetBundle>;
}

#[version(1)]
/// Constructible CPU decoder uploading through the target renderer's owned-image factory.
factory PngDecoder: IAssetDiagnostics {
    /// Decodes one static PNG and uploads exact normalized RGBA through a borrowed factory.
    /// The complete input starts at offset zero; encoded and decoded data are bounded to 64 MiB.
    /// Decoder failures never call the factory. Upload failures preserve their original status.
    fn upload(&self, png: &[u8], target: &ITextureFactory) -> Result<ITexture>;
}

#[version(1)]
/// Simple RGBA color stored with 8-bit components.
#[deserialize(sequence)]
struct Color {
    /// Red channel.
    r: u8,
    /// Green channel.
    g: u8,
    /// Blue channel.
    b: u8,
    /// Alpha channel.
    a: u8,
}

/// Named flat colors used as inputs to visual-catalog construction.
///
/// A palette is an authoring value, not retained runtime appearance state. Compiling it eagerly into
/// complete resolved visual values avoids the former shadow color array that could disagree with
/// what widgets actually painted.
#[version(1)]
#[deserialize(default)]
struct FlatPalette {
    /// Ordinary control text and semantic glyph color.
    text: Color,
    /// Generic flat frame and control border color.
    border: Color,
    /// Window and dialog client-area background.
    window_background: Color,
    /// Base window title background used when the active chrome role is not selected.
    title_background: Color,
    /// Window title and caption foreground.
    title_foreground: Color,
    /// Panel and scroll-viewport background.
    panel_background: Color,
    /// Ordinary raised-control fill.
    button: Color,
    /// Hovered raised-control fill.
    button_hovered: Color,
    /// Ordinary recessed-control fill.
    input: Color,
    /// Hovered recessed-control fill.
    input_hovered: Color,
    /// Scrollbar track fill.
    scrollbar_track: Color,
    /// Scrollbar thumb fill.
    scrollbar_thumb: Color,
    /// Focused control border or fill accent.
    control_focus: Color,
    /// Background used by hovered, keyboard-focused, open, or otherwise selected items.
    selection_background: Color,
    /// Text and glyph color paired with [`Self::selection_background`].
    selection_foreground: Color,
    /// Active window frame and title accent.
    window_active: Color,
    /// Menu text and marker foreground.
    menu_foreground: Color,
    /// Menu bar and popup background.
    menu_background: Color,
    /// Disabled control and client-area background.
    disabled_background: Color,
    /// Disabled body, menu, and control foreground.
    disabled_foreground: Color,
    /// Disabled title and caption foreground.
    disabled_title_foreground: Color,
}

/// Process entry factory for the retained UI implementation plugin.
#[version(1)]
factory UiPluginFactory {
    /// Creates one independent retained UI from an immutable asset bundle.
    fn create_runtime(&self, assets: &IAssetBundle) -> Result<UiRuntime>;
}

/// Process entry factory for optional asset construction services.
#[version(1)]
factory AssetsPluginFactory {
    /// Creates the PNG upload service.
    fn png_decoder(&self) -> Result<PngDecoder>;
    /// Creates the style derivation service.
    fn style_compiler(&self) -> Result<StyleCompiler>;
    /// Creates the optional atlas builder service.
    fn asset_loader(&self) -> Result<AssetLoader>;
    /// Creates the optional JSON theme loader service.
    fn theme_loader(&self) -> Result<ThemeLoader>;
}
