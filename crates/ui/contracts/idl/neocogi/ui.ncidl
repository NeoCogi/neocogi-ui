#[version(1)]
/// Whether preferred measurement or child placement inputs changed.
    enum GeometryChange: u8 {
        /// Preferred measurement and placement inputs are unchanged.
        NO_CHANGE = 0,
        /// Preferred measurement or placement inputs changed and must be invalidated.
        CHANGED = 1,
    }

#[version(1)]
/// Canonical copied pixel dimensions for UI contracts.
struct Size {
    /// Horizontal extent in pixels.
    width: i32,
    /// Vertical extent in pixels.
    height: i32,
}

#[version(1)]
/// Active paint invocation plus a caller-narrowable local clip, checked by the runtime paint context.
struct PaintScope {
    /// Non-reused invocation number; zero never identifies an active call.
    invocation: u64,
    /// Requested local clip. The service always intersects it with the widget's actual clip;
    /// modifying this copied field cannot grant drawing authority outside the widget.
    clip: Rect,
}

#[version(1)]
/// Closed visual state used when the runtime resolves a semantic widget frame.
    enum WidgetVisualState: u8 {
        /// Disabled surface or control.
        DISABLED = 0,
        /// Enabled surface or unfocused control without pointer interaction.
        NORMAL = 1,
        /// Enabled unfocused control under the pointer.
        HOVERED = 2,
        /// Enabled unfocused control actively pressed under the pointer.
        PRESSED = 3,
        /// Focused control without pointer interaction.
        FOCUSED = 4,
        /// Focused control under the pointer.
        FOCUSED_HOVERED = 5,
        /// Focused control actively pressed under the pointer.
        FOCUSED_PRESSED = 6,
    }

#[version(1)]
/// Bundle-local font slot selected from the exact asset revision used for this paint call.
struct PaintFont {
    /// Zero-based font table index; the paint context rejects values outside its installed atlas.
    index: u32,
}

#[version(1)]
/// Bundle-local icon slot selected from the exact asset revision used for this paint call.
struct PaintIcon {
    /// Zero-based icon table index; the paint context rejects values outside its installed atlas.
    index: u32,
}

#[version(1)]
/// Copied rectangle in the current widget's local coordinate system.
struct Rect {
    /// Horizontal origin.
    x: i32,
    /// Vertical origin.
    y: i32,
    /// Nonnegative horizontal extent.
    width: i32,
    /// Nonnegative vertical extent.
    height: i32,
}

#[version(2)]
/// Scoped facade which appends typed operations to the runtime's current frame paint context.
trait IPainter {
    /// Records a nonnegative-width solid line with finite local endpoints. Zero width draws nothing.
    fn stroke_line(&mut self, scope: PaintScope, from: PaintPoint, to: PaintPoint, width: f32, rgba: u32) -> Result<()>;
    /// Records finite local polygon points at offset zero; fewer than three points draw nothing.
    /// Concave polygon tessellation and clipping use the same UI implementation as built-in drawing.
    fn fill_polygon(&mut self, scope: PaintScope, points: &[PaintPoint], rgba: u32) -> Result<()>;
    /// Records solid triangles in widget-local coordinates. The complete input starts at offset zero,
    /// has a multiple of three vertices and contains only finite positions. Atlas mapping belongs
    /// to the UI implementation and follows the currently installed resource revision.
    fn colored_triangles(&mut self, scope: PaintScope, vertices: &[ColoredVertex]) -> Result<()>;
    /// Records complete atlas triangles in local coordinates; offset is zero,
    /// length is divisible by three, and every position/UV component is finite.
    fn triangles(&mut self, scope: PaintScope, vertices: &[RenderVertex]) -> Result<()>;
    /// Retains an immutable renderer-owned RGBA texture and draws its normalized source region in local coordinates.
    /// Negative extents are invalid; zero extents draw nothing. Ownership is validated before GPU execution.
    fn texture(&mut self, scope: PaintScope, rect: Rect, source: TextureRegion, rgba: u32, texture: &ITexture) -> Result<()>;
    /// Retains a renderer-owned custom item at this exact painter-order position.
    /// The UI translates the rectangle and intersects its clip before submission.
    fn item(&mut self, scope: PaintScope, rect: Rect, item: &IRenderItem) -> Result<()>;
    /// Records a fill only while this exact invocation remains active.
    fn fill(&mut self, scope: PaintScope, rect: Rect, rgba: u32) -> Result<()>;
    /// Records UTF-8 text with the current body font and button content style.
    fn text(&mut self, scope: PaintScope, rect: Rect, text: &[u8]) -> Result<()>;
    /// Resolves and records one semantic surface or control frame, returning its usable interior.
    /// `center_only` removes destination insets without changing the selected artwork.
    fn frame(&mut self, scope: PaintScope, rect: Rect, role: WidgetFrame, state: WidgetVisualState, center_only: bool) -> Result<Rect>;
    /// Records one atlas icon selected by its slot in the current immutable asset bundle.
    fn icon(&mut self, scope: PaintScope, icon: PaintIcon, rect: Rect, rgba: u32) -> Result<()>;
    /// Records one UTF-8 text run at an explicit local baseline-aligned position.
    fn text_run(&mut self, scope: PaintScope, font: PaintFont, position: Point, rgba: u32, text: &[u8]) -> Result<()>;
}

#[version(1)]
/// Common retained widget capability shared by all concrete widget interfaces.
trait IWidget {
    /// Returns the allocating runtime's identity service, which owns no tree.
    fn host(&self) -> Result<IWidgetHost>;
    /// Claims the only tree attachment; a second call fails without changing state.
    fn mount(&mut self) -> Result<()>;
    /// Logically closes the widget without requiring its final reference release.
    fn close(&mut self) -> Result<()>;

    /// Returns current frame, focus and pointer-routing policy as one copied record.
    fn properties(&self) -> Result<WidgetProperties>;
    /// Changes common options and records sticky geometry invalidation when they differ.
    fn set_options(&mut self, options: WidgetOptions) -> Result<()>;
    /// Processes one router-owned snapshot; the text argument is UTF-8 only for Text events.
    /// Return CHANGED for every modification to measurement or child placement inputs.
    fn update(&mut self, state: WidgetUpdate, event: WidgetEvent, text: &[u8]) -> Result<GeometryChange>;

    /// Drains sticky geometry invalidation recorded by programmatic setters.
    fn take_change(&mut self) -> Result<GeometryChange>;
    /// Records this widget's visual output within a validated paint invocation.
    fn paint(&mut self, scope: PaintScope, state: WidgetPaint, painter: &IPainter) -> Result<()>;
}

#[version(1)]
/// Ordered child access, independent of concrete container layout policy.
trait IChildren {
    /// Returns the current number of direct children.
    fn child_count(&self) -> Result<u32>;
    /// Returns an owned reference to one direct child; topology ownership is a separate contract.
    fn child(&self, index: u32) -> Result<IWidget>;
}

#[version(1)]
/// Constructible button class with only its shared widget and leaf-layout protocols separated.
class Button: IWidget + ILeafLayout {

    /// Replaces the complete UTF-8 label; the logical input offset must be zero.
    fn set_label(&mut self, label: &[u8]) -> Result<()>;

    /// Returns the current label as an independently owned immutable string object.
    fn label(&self) -> Result<String>;

    /// Connects the exclusive activation subscriber and returns its ownership lease.
    fn subscribe(&mut self, sink: &IActivationSink) -> Result<IEventSubscription>;

    /// Selects a semantic font role and invalidates measurement only when it differs.
    fn set_font_role(&mut self, role: FontRole) -> Result<()>;

    /// Resolves an exact named font in the current host bundle before committing.
    fn set_named_font(&mut self, name: &[u8]) -> Result<()>;

    /// Selects a semantic icon or removes it while retaining the label.
    fn set_icon_role(&mut self, icon: ContentIcon) -> Result<()>;

    /// Resolves an exact named icon in the current host bundle before committing.
    fn set_named_icon(&mut self, name: &[u8]) -> Result<()>;

    /// Returns the interaction states that fill an unframed button's center.
    fn fill_states(&self) -> Result<FillStates>;

    /// Replaces the validated paint-only center-fill mask.
    fn set_fill_states(&mut self, states: FillStates) -> Result<()>;

    /// Installs a positive-sized renderer-owned image, optionally fitted to width.
    fn set_image(&mut self, image: &ITexture, fit_width: bool) -> Result<()>;

    /// Removes image content while retaining the current label and font.
    fn clear_image(&mut self) -> Result<()>;
}

#[version(1)]
/// Dynamically implemented construction shorthand over registered widget contracts.
factory UiFactory {

    /// Returns this factory's non-owning authority for inline WidgetState in independent widget classes.
    fn host(&self) -> Result<IWidgetHost>;
    /// Creates an empty combo header; its composing owner supplies generic list data and popup content.
    fn create_combo(&self) -> Result<Combo>;
    /// Creates a fixed scrolling multiline editor; CRLF and CR normalize to LF and the cursor starts at the end.
    fn create_text_area(&self, text: &[u8], wrapping: TextWrapping, scrolling: bool) -> Result<TextArea>;
    /// Creates an empty disclosure with a real text header and editable vertical Linear body.
    fn create_disclosure(&self, label: &[u8], style: DisclosureStyle, expanded: bool) -> Result<Disclosure>;
    /// Creates a framed scroll composite around one unmounted content object; generic options can subsequently change its frame.
    fn create_scroll_area(&self, content: &IWidget, enabled: bool) -> Result<ScrollArea>;
    /// Creates an empty directional container after validating its complete initial policy.
    fn create_linear(&self, direction: FlowDirection, cross: CrossSize) -> Result<Linear>;
    /// Creates an empty Grid with validated complete column and row policies; input offsets must be zero.
    fn create_grid(
        &self,
        columns: &[LayoutTrack],
        rows: &[LayoutTrack],
    ) -> Result<Grid>;
    /// Constructs an unmounted boolean control with body-font presentation.
    fn create_checkbox(&self, checked: bool, label: &[u8]) -> Result<Checkbox>;
    /// Constructs an unmounted normalized single-line editor.
    fn create_textbox(&self, text: &[u8]) -> Result<Textbox>;
    /// Constructs multiline display text using the explicit wrapping policy.
    fn create_text_block(&self, text: &[u8], wrapping: TextWrapping) -> Result<TextBlock>;
    /// Constructs a slider after validating every arithmetic input.
    fn create_slider(&self, options: SliderOptions) -> Result<Slider>;
    /// Constructs standalone numeric entry after validating arithmetic inputs.
    fn create_number(&self, options: NumberOptions) -> Result<Number>;
    /// Constructs an RGBA swatch with an optional label.
    fn create_color_swatch(&self, rgba: u32, label: &[u8]) -> Result<ColorSwatch>;
    /// Constructs one list row; application data is attached in its static adapter.
    fn create_list_item(&self, label: &[u8]) -> Result<ListItem>;
    /// Constructs a button-like list entry.
    fn create_list_box(&self, label: &[u8]) -> Result<ListBox>;
    /// Constructs a scrollbar with a validated orientation and normalized range.
    fn create_scrollbar(&self, range: ScrollRange) -> Result<Scrollbar>;
    /// Constructs an initialized, unmounted Button through its concrete class contract.
    fn create_button(&self, label: &[u8], options: WidgetOptions) -> Result<Button>;
}

#[version(1)]
/// Immutable resource view shared for a complete layout transaction.
trait ITextMetrics {
    /// Measures a UTF-8 button label, including theme padding.
    fn button_size(&self, text: &[u8]) -> Result<Size>;
}

#[version(1)]
/// Whether an axis has a finite measurement maximum.
    enum LimitKind: u8 {
        /// Extent is a nonnegative maximum; zero remains a real bound.
        FINITE = 0,
        /// Preferred size is requested without a finite maximum; extent must be zero.
        UNBOUNDED = 1,
    }

#[version(1)]
/// Copied axis constraint; the tag distinguishes zero from unbounded space.
struct AxisLimit {
    /// Explicit finite/unbounded interpretation.
    kind: LimitKind,
    /// Nonnegative bound for FINITE, zero for UNBOUNDED.
    extent: i32,
}

#[version(1)]
/// Independent horizontal and vertical measurement constraints.
struct LayoutLimits {
    /// Available horizontal space.
    width: AxisLimit,
    /// Available vertical space.
    height: AxisLimit,
}

#[version(1)]
/// Preferred-size capability for a leaf; measurement may refresh private resource caches.
trait ILeafLayout {
    /// Computes preferred dimensions from explicit finite/unbounded axis constraints.
    fn measure(&mut self, bounds: LayoutLimits, metrics: &ITextMetrics) -> Result<Size>;
}

#[version(1)]
/// Visibility intent or effective surface visibility, as documented by the operation.
    enum Visibility: u8 {
        /// Excluded from rendering and input.
        HIDDEN = 0,
        /// Eligible when structural and modal owner policy also permits it.
        VISIBLE = 1,
    }

#[version(1)]
/// How a parent clips its structural child windows.
    enum ChildClip: u8 {
        /// Inherit the ancestor/viewport clip without narrowing to the parent's body.
        NONE = 0,
        /// Clip complete child surfaces to the parent's application content area.
        CONTENT = 1,
    }

#[version(1)]
/// Structural layer category for a window or dialog.
    enum LayerKind: u8 {
        /// An independent or inherited application layer in 0..=15.
        FIXED = 0,
        /// Dedicated modal band above all application layers; number is zero.
        MODAL = 1,
    }

#[version(1)]
/// Explicit fixed or manager-controlled modal stacking band.
struct WindowLayer {
    /// Interpretation of the numeric field.
    kind: LayerKind,
    /// Fixed application layer, or zero when modal.
    number: u8,
}

#[version(1)]
/// Concrete window presentation bits; unknown bits are rejected before mutation.
struct WindowOptions {
    /// Union of the documented constants on this type.
    bits: u32,
}

#[version(1)]
/// Immutable copied observation of the manager's authoritative window state.
struct WindowSnapshot {
    /// Current outer screen rectangle.
    rect: Rect,
    /// Current presentation options.
    options: WindowOptions,
    /// Effective visibility including structural ancestors.
    visibility: Visibility,
    /// Fixed, inherited or modal stacking policy.
    layer: WindowLayer,
    /// Parent-owned clipping applied to this window's structural children.
    child_clip: ChildClip,
}

#[version(1)]
/// Logical UI window retained independently of its runtime's tree membership.
trait IWindow {
    /// Copies current authoritative geometry, visibility and policy without caching app-side state.
    fn snapshot(&self) -> Result<WindowSnapshot>;
    /// Returns an immutable UTF-8 title snapshot.
    fn title(&self) -> Result<String>;
    /// Replaces the complete title silently; UTF-8 input offset must be zero.
    fn set_title(&self, title: &[u8]) -> Result<()>;
    /// Changes local visibility intent; ancestors and modal policy determine effective visibility.
    fn set_visibility(&self, visibility: Visibility) -> Result<()>;
    /// Changes concrete presentation options and reconciles capture/disabled descendants.
    fn set_options(&self, options: WindowOptions) -> Result<()>;
    /// Selects a fixed layer in 0..=15; child/dialog layers are manager-controlled.
    fn set_layer(&self, layer: u8) -> Result<()>;
    /// Raises within the permitted structural stacking band.
    fn raise(&self) -> Result<()>;
    /// Changes the clipping applied to structural child windows.
    fn set_child_clip(&self, clip: ChildClip) -> Result<()>;
    /// Changes allocation and schedules layout; negative extents are rejected.
    fn set_rect(&self, rect: Rect) -> Result<()>;
    /// Removes the subtree; retained capabilities subsequently report closure.
    fn close(&self) -> Result<()>;
}

#[version(1)]
/// Window policy and topology are owned by the UI runtime object.
trait IWindowManager {
    /// Creates a visible structural child; a modal parent is rejected before claiming the widget.
    fn create_child(
        &self,
        parent: &IWindow,
        title: &[u8],
        rect: Rect,
        root: &IWidget,
    ) -> Result<IWindow>;
    /// Creates a hidden modal dialog owned by an ordinary window.
    fn create_dialog(
        &self,
        parent: &IWindow,
        title: &[u8],
        rect: Rect,
        root: &IWidget,
    ) -> Result<IWindow>;
    /// Creates a hidden auto-sized popup owned by a live window or dialog.
    fn create_popup(
        &self,
        parent: &IWindow,
        title: &[u8],
        root: &IWidget,
    ) -> Result<IPopup>;
    /// Mounts one previously unmounted root and creates its logical window.
    fn create_window(&self, title: &[u8], rect: Rect, root: &IWidget) -> Result<IWindow>;
}

#[version(1)]
/// One constructible retained UI with input, rendering, and resource ownership.
class UiRuntime: IInputSink + IWindowManager + IMenus + IFileDialogs {

    /// Returns the dynamically implemented construction shorthand bound to this UI.
    fn factory(&self) -> Result<UiFactory>;

    /// Retains the currently installed immutable revision, suitable for restoration or another consumer.
    fn assets(&self) -> Result<IAssetBundle>;
    /// Validates compatible resources and prepares the renderer upload before publishing either UI
    /// projection. The mutable receiver makes the authority to replace this runtime-wide value
    /// explicit. Failure preserves the old bundle. Success requires update before rendering.
    /// Callers install only after update or event dispatch returns; overlapping runtime calls reject
    /// the exclusive receiver with BUSY. The renderer is borrowed only for this call.
    fn install_assets(&mut self, assets: &IAssetBundle, renderer: &IRenderer) -> Result<()>;
    /// Drains queued input, or one eventless update, and synchronizes setters/resize without an application dispatcher.
    fn update(&self, size: Size) -> Result<()>;
    /// Borrows application dispatch at each safe boundary; handlers may mutate windows/topology before the next input is routed.
    /// The runtime never retains dispatcher; update/render reentry returns BUSY even while the context is available to handlers.
    fn update_with_events(&self, size: Size, dispatcher: &IEventDispatcher) -> Result<()>;
    /// Returns the committed editable focus rectangle in drawable coordinates, or None while
    /// geometry/input is pending. Hosts synchronize native IME after each successful update.
    fn text_input_area(&self) -> Result<TextInputArea>;
    /// Paints only after update has synchronized geometry for this drawable size.
    fn render(&self, size: Size, renderer: &IRenderer) -> Result<()>;
    /// Logically closes every mounted subtree; COM allocations may outlive closure.
    fn close(&self) -> Result<()>;
}

#[version(1)]
/// Runtime identity and mutation authority without a reference back to its tree.
trait IWidgetHost {
    /// Retains the current immutable resource revision without owning the runtime tree.
    /// Custom widgets cache bulk metadata by this bundle identity and refresh it during the next
    /// measure/paint after replacement; never retain UVs or glyph metrics across a different revision.
    fn assets(&self) -> Result<IAssetBundle>;
    /// Creates an empty private child editor; containers expose only its read-only view.
    fn create_children(&self) -> Result<IChildrenEditor>;
    /// Checks lifetime without forbidding observational reads during layout or painting.
    fn check_open(&self) -> Result<()>;
    /// Rejects closed runtimes and mutation during layout or painting.
    fn check_mutation(&self) -> Result<()>;
}

#[version(2)]
/// A popup has transient placement and cannot be passed to ordinary window operations.
trait IPopup {
    /// Reports whether this popup belongs to the manager's active visible branch.
    fn visibility(&self) -> Result<Visibility>;
    /// Activates the popup's input scope at the latest consumed pointer position.
    fn show(&mut self) -> Result<()>;
    /// Atomically sets an exact screen anchor and activates the popup's input scope.
    fn show_at(&mut self, anchor: Rect) -> Result<()>;
    /// Dismisses this active branch while preserving the definition for later reuse.
    fn hide(&mut self) -> Result<()>;
    /// Changes popup framing, padding and preferred-size policy.
    fn set_options(&mut self, options: WindowOptions) -> Result<()>;
    /// Permanently removes this popup subtree and closes its retained widgets.
    fn close(&mut self) -> Result<()>;
}

#[version(1)]
/// Integer point or delta in the receiving widget's local coordinates.
struct Point {
    /// Horizontal coordinate or displacement.
    x: i32,
    /// Vertical coordinate or displacement.
    y: i32,
}

#[version(1)]
/// Logical keyboard identity, independent of native scan codes.
    enum KeyCode: u8 {
        /// Printable shortcut key; its scalar is carried in `KeyStroke::value`.
        CHARACTER = 0,
        /// Removes the previous character.
        BACKSPACE = 1,
        /// Removes the next character.
        DELETE = 2,
        /// Primary activation or line break.
        ENTER = 3,
        /// Cancellation or popup dismissal.
        ESCAPE = 4,
        /// Space-bar activation, separate from committed text.
        SPACE = 5,
        /// Sequential focus traversal.
        TAB = 6,
        /// Insert editing command.
        INSERT = 7,
        /// Beginning of content or line.
        HOME = 8,
        /// End of content or line.
        END = 9,
        /// Previous viewport.
        PAGE_UP = 10,
        /// Next viewport.
        PAGE_DOWN = 11,
        /// Upward navigation.
        ARROW_UP = 12,
        /// Downward navigation.
        ARROW_DOWN = 13,
        /// Leftward navigation.
        ARROW_LEFT = 14,
        /// Rightward navigation.
        ARROW_RIGHT = 15,
        /// Numbered function key; its number is carried in `KeyStroke::value`.
        FUNCTION = 16,
        /// Alt/Option itself, for distinguishing a tap from a chord.
        ALT = 17,
        /// Control modifier itself.
        CONTROL = 18,
        /// Shift modifier itself.
        SHIFT = 19,
        /// Command/Windows/Super modifier itself.
        SUPER = 20,
    }

#[version(1)]
/// Complete logical key transition; text composition uses `WidgetEvent::Text`.
struct KeyStroke {
    /// Stable logical key family.
    key: KeyCode,
    /// Unicode scalar for CHARACTER, function number for FUNCTION, otherwise zero.
    value: u32,
    /// True for a press, false for a release.
    pressed: bool,
    /// True only for a platform-generated repeated press.
    repeat: bool,
    /// Complete modifier bits: Alt=1, Ctrl=2, Shift=4, Super=8.
    modifiers: u8,
}

#[version(1)]
/// One routed input transaction; pointer payloads are already content-local.
enum WidgetEvent: u8 {
    /// Ordinary eventless update, including animation or state synchronization.
    None,
    /// Native focus or capture was lost.
    Cancel,
    /// Pointer motion without held buttons.
    Move {
        /// Current local position.
        position: Point,
        /// Change since the previous queued position.
        delta: Point,
    },
    /// Pointer motion under capture or with held buttons.
    Drag {
        /// Current local position.
        position: Point,
        /// Change since the previous queued position.
        delta: Point,
        /// Held buttons: left=1, right=2, middle=4.
        buttons: u8,
    },
    /// Pointer button press.
    Down {
        /// Local press position.
        position: Point,
        /// Buttons changed by this transition.
        buttons: u8,
    },
    /// Pointer button release.
    Up {
        /// Local release position.
        position: Point,
        /// Buttons changed by this transition.
        buttons: u8,
    },
    /// Wheel or equivalent scrolling input.
    Scroll {
        /// Current local pointer position.
        position: Point,
        /// Requested scroll amount.
        delta: Point,
    },
    /// One complete logical keyboard transition.
    Key(KeyStroke),
    /// The accompanying bounded UTF-8 argument carries the complete committed text.
    Text,
}

#[version(1)]
/// Router-owned geometry and interaction snapshot for one widget update.
struct WidgetUpdate {
    /// Whether pointer hit tests belong to the currently hovered logical root.
    in_hover_root: bool,
    /// Content allocation with local origin (0, 0).
    rect: Rect,
    /// Effective content-local clip.
    clip: Rect,
    /// Content allocation in native drawable coordinates, for input-method placement.
    screen: Rect,
    /// Pointer currently hovers this surface.
    hovered: bool,
    /// This surface owns logical keyboard focus.
    focused: bool,
    /// An eligible primary-button press selected this surface in this transaction.
    clicked: bool,
    /// This surface owns pointer capture while the primary button is held.
    active: bool,
    /// Shared action derived from the routed event and declared keyboard capabilities.
    action: WidgetAction,
    /// Current held mouse buttons using the same bits as pointer event payloads.
    mouse_buttons: u8,
    /// Complete current modifier snapshot using KeyStroke's bit assignments.
    modifiers: u8,
}

#[version(1)]
/// Shared semantic keyboard/pointer action resolved by the runtime's routing rules.
    enum WidgetAction: u8 {
        /// No semantic action was requested.
        NONE = 0,
        /// Invoke the primary command.
        ACTIVATE = 1,
        /// Move one step toward the lower value.
        DECREASE = 2,
        /// Move one step toward the higher value.
        INCREASE = 3,
        /// Reveal a hierarchical branch or popup.
        EXPAND = 4,
        /// Hide a hierarchical branch or popup.
        COLLAPSE = 5,
    }

#[version(1)]
/// Ordered host input before the runtime computes drag, hover and local coordinates.
enum UiInput: u8 {
    /// Native focus or capture was lost; clears held state in input order.
    Cancel,
    /// Absolute pointer position in drawable coordinates.
    Pointer(Point),
    /// Button press at an absolute drawable position.
    Down {
        /// Current drawable position.
        position: Point,
        /// Buttons changed by this transition.
        buttons: u8,
    },
    /// Button release at an absolute drawable position.
    Up {
        /// Current drawable position.
        position: Point,
        /// Buttons changed by this transition.
        buttons: u8,
    },
    /// Wheel delta at the last committed pointer position.
    Scroll(Point),
    /// Complete key identity, state and modifiers.
    Key(KeyStroke),
    /// Complete UTF-8 commit supplied in the accompanying bounded text argument.
    Text,
}

#[version(1)]
/// Concrete labelled activation consumer shared by Button, ListItem and ListBox.
trait IActivationSink {
    /// Receives an immutable submission snapshot after widget traversal releases its borrows.
    fn submitted(&self, label: &str) -> Result<()>;
}

#[version(1)]
/// Lease owning one queue and typed consumer; the driver retains this lease.
trait IEventSubscription {
    /// Delivers at most limit callbacks from one detached FIFO prefix; zero rejects only when events are pending.
    /// A callback error consumes that attempted event and preserves unattempted ordinary events ahead of later emissions.
    fn dispatch(&self, limit: u32) -> Result<u32>;
    /// Reports a live source or an undelivered terminal fact; cancelled and closed-empty leases are inactive.
    fn active(&self) -> Result<bool>;
    /// Disconnects explicitly; final object release also disconnects without invoking user code.
    fn cancel(&self) -> Result<()>;
}

#[version(1)]
/// Shared labelled activation source; the producer never owns the returned lease or its sink.
trait IActivationEvents {
    /// Connects the exclusive subscriber and returns its ownership lease.
    fn subscribe(&self, sink: &IActivationSink) -> Result<IEventSubscription>;
}

#[version(1)]
/// Committed user checkbox state; programmatic setters do not publish it.
trait ICheckboxSink {
    /// Receives the captured value after retained traversal releases its owned state.
    fn changed(&self, checked: bool) -> Result<()>;
}

#[version(1)]
/// Committed finite user value shared by Slider and Number; programmatic setters do not publish it.
trait INumericSink {
    /// Receives the captured value after retained traversal releases its owned state.
    fn changed(&self, value: f32) -> Result<()>;
}

#[version(1)]
/// Committed clamped scrollbar offset from pointer input; programmatic setters do not publish it.
trait IScrollbarSink {
    /// Receives the captured value after retained traversal releases its owned state.
    fn changed(&self, offset: i32) -> Result<()>;
}

#[version(1)]
/// Complete normalized text and scalar-aligned UTF-8 byte cursor at the moment of a user edit.
trait ITextChangedSink {
    /// Receives an owned immutable text capability borrowed only for this synchronous delivery.
    fn changed(&self, text: &str, cursor: u64) -> Result<()>;
}

#[version(1)]
/// Complete normalized text at submission, independent of later edits.
trait ITextSubmittedSink {
    /// Receives the already captured submission value after traversal.
    fn submitted(&self, text: &str) -> Result<()>;
}

#[version(1)]
/// Shared editor event family; changed and submitted are independent exclusive ports.
trait ITextEvents {
    /// Connects one changed consumer without claiming the separate submitted port.
    fn subscribe_changed(&mut self, sink: &ITextChangedSink) -> Result<IEventSubscription>;
    /// Connects one submitted consumer without claiming the separate changed port.
    fn subscribe_submitted(&mut self, sink: &ITextSubmittedSink) -> Result<IEventSubscription>;
}

#[version(1)]
/// Borrowed application-owned dispatcher; the UI runtime must never retain this capability.
trait IEventDispatcher {
    /// Sweeps registered sources in deterministic order until empty or the callback budget is exhausted.
    fn dispatch(&self, limit: u32) -> Result<u32>;
}

#[version(1)]
/// Captured window lifecycle or user chrome interaction; Destroyed is the one terminal fact.
enum WindowEvent: u8 {
    /// A user move or resize committed this complete outer rectangle.
    GeometryChanged {
        /// Captured outer geometry, independent of subsequent window edits.
        rect: Rect,
    },
    /// The user activated the close affordance; the application decides whether to close.
    CloseRequested,
    /// Visibility became false; later callback code may observe a subsequent show.
    Hidden,
    /// The window and its descendants were logically destroyed; delivered once after producer closure.
    Destroyed,
    /// The user minimized to this complete compact rectangle.
    Minimized {
        /// Captured compact outer geometry.
        rect: Rect,
    },
    /// The user maximized into this inherited viewport rectangle.
    Maximized {
        /// Captured maximized outer geometry.
        rect: Rect,
    },
    /// The user restored this previously saved rectangle.
    Restored {
        /// Captured restored outer geometry.
        rect: Rect,
    },
}

#[version(1)]
/// Concrete consumer of copied window events, including the terminal Destroyed fact.
trait IWindowSink {
    /// Receives the exact committed lifecycle/chrome snapshot after the manager releases traversal ownership.
    fn event(&self, event: WindowEvent) -> Result<()>;
}

#[version(1)]
/// Subscription capability on the actual logical window object; the manager owns its existing native source.
trait IWindowEvents {
    /// Connects the current source without making a retained window reference prolong native tree ownership.
    fn subscribe(&self, sink: &IWindowSink) -> Result<IEventSubscription>;
}

#[version(1)]
/// Concrete consumer of ordinary popup dismissal; destruction does not fabricate replay history.
trait IPopupSink {
    /// Reports removal from the active popup branch, independently of later activation.
    fn dismissed(&self) -> Result<()>;
}

#[version(1)]
/// Subscription capability on the actual popup object and its existing manager-owned source.
trait IPopupEvents {
    /// Returns an exclusive application-owned dismissal lease without retaining application state on the producer.
    fn subscribe(&self, sink: &IPopupSink) -> Result<IEventSubscription>;
}

#[version(1)]
/// Captured user selection committed by a combo's composing popup owner.
trait IComboChangedSink {
    /// Receives the matching application-list position and display label from one selection.
    fn changed(&self, selected: u64, label: &str) -> Result<()>;
}

#[version(1)]
/// Header activation requests ordinary popup coordination using copied routed geometry.
trait IComboPopupSink {
    /// Receives the desired open state and screen-space anchor captured at header activation.
    fn submitted(&self, open: bool, anchor: Rect) -> Result<()>;
}

#[version(1)]
/// Concrete terminal outcome of one request; there is no impossible Pending event variant.
trait IFileDialogSink {
    /// Accepts an exact native path independently of its potentially lossy filename label.
    fn accepted(&self, path: &INativePath) -> Result<()>;
    /// Reports explicit cancellation, hiding, close affordance or destruction of an active request.
    fn cancelled(&self) -> Result<()>;
}

#[version(1)]
/// Independent completion source for this reusable picker, using the shared application-owned lease transport.
trait IFileDialogEvents {
    /// Connects one concrete completion consumer without retaining the application on the producer.
    fn subscribe(&self, sink: &IFileDialogSink) -> Result<IEventSubscription>;
}

#[version(1)]
/// UI-owned file picker controller and real COM controls; retaining its interface does not keep its runtime open.
trait IFileDialog {
    /// Returns the actual stable modal window capability for ordinary lifecycle and geometry operations.
    fn window(&self) -> Result<IWindow>;
    /// Reads and validates a complete native directory before changing request state or showing the modal.
    fn open(&self, title: &[u8], rect: Rect, directory: &INativePath) -> Result<()>;
    /// Reports whether a request is active; hidden/idle is distinct from permanently closed.
    fn active(&self) -> Result<bool>;
    /// Cancels one active request and hides its reusable modal; idle cancellation returns false.
    fn cancel(&self) -> Result<bool>;
    /// Permanently destroys the modal and ends its active request, while retained handles remain safe.
    fn close(&self) -> Result<()>;
    /// Copies the latest failed directory-read diagnostic without replacing the previous valid listing.
    fn diagnostic(&self) -> Result<String>;
}

#[version(1)]
/// Standard picker construction capability on the same runtime identity as ordinary window management.
trait IFileDialogs {
    /// Creates one hidden reusable modal owned by the authenticated ordinary window.
    fn create(&self, parent: &IWindow) -> Result<IFileDialog>;
}

#[version(1)]
/// Persistent menu marker role remains present even when its selected boolean is false.
enum MenuMark: u8 {
    /// No marker role or required marker gutter.
    None,
    /// Checkable item whose boolean determines check-glyph visibility.
    Checked {
        /// Current presentation state; submission does not toggle it automatically.
        checked: bool,
    },
    /// Radio item whose boolean determines selection-marker visibility.
    Radio {
        /// Current presentation state; application code owns radio-group policy.
        selected: bool,
    },
}

#[version(1)]
/// Live compact row capability, editable before mounting and while its owning surface exists.
trait IMenuItem {
    /// Returns the same label used by measurement, paint and captured submissions.
    fn label(&self) -> Result<String>;
    /// Replaces complete UTF-8 display text without publishing user activation.
    fn set_label(&self, label: &[u8]) -> Result<()>;
    /// Reports pointer and keyboard eligibility, independently of marker presentation.
    fn enabled(&self) -> Result<bool>;
    /// Silently changes interaction eligibility; disabled rows remain visible.
    fn set_enabled(&self, enabled: bool) -> Result<()>;
    /// Returns the concrete check/radio role and its current presentation state.
    fn mark(&self) -> Result<MenuMark>;
    /// Silently changes the complete marker role; radio grouping remains the caller's responsibility.
    fn set_mark(&self, mark: MenuMark) -> Result<()>;
    /// Returns presentation-only accelerator text, with empty text representing absence.
    fn shortcut_hint(&self) -> Result<String>;
    /// Changes presentation only; it does not install a keyboard shortcut handler.
    fn set_shortcut_hint(&self, hint: &[u8]) -> Result<()>;
}

#[version(1)]
/// Unique declaration tree consumed once by the owning manager; retained item capabilities remain live afterward.
trait IMenuBuilder {
    /// Appends an enabled unmarked row and returns its editing/event capability.
    fn item(&self, label: &[u8]) -> Result<IMenuItem>;
    /// Appends one noninteractive separator in exact declaration order.
    fn separator(&self) -> Result<()>;
    /// Appends a submenu and returns a builder scoped to that child; only the root is mountable.
    fn submenu(&self, label: &[u8]) -> Result<IMenuBuilder>;
}

#[version(1)]
/// Menu construction and attachment capability on the same runtime identity as the window manager.
trait IMenus {
    /// Creates one root declaration; for a bar its direct entries must all be submenus.
    fn create(&self, label: &[u8]) -> Result<IMenuBuilder>;
    /// Installs a bar once on a live window; validates owner, declaration shape and prior attachment before transfer.
    fn attach_bar(&self, window: &IWindow, menu: &IMenuBuilder) -> Result<()>;
    /// Creates an ordinary hidden popup from one root declaration, including all its nested menus.
    fn create_popup(&self, window: &IWindow, menu: &IMenuBuilder) -> Result<IPopup>;
}

#[version(1)]
/// Native path representation carried by an immutable path capability.
    enum PathEncoding: u8 {
        /// Exact Unix filename bytes; invalid UTF-8 is preserved.
        UNIX_BYTES = 0,
        /// Exact Windows UTF-16 code units; unpaired surrogates are preserved.
        WINDOWS_UTF16 = 1,
    }

#[version(1)]
/// Immutable native path snapshot with explicit encoding and separate display-only text.
trait INativePath {
    /// Reports which typed copy method applies; callers reject incompatible host encodings.
    fn encoding(&self) -> Result<PathEncoding>;
    /// Returns bytes or UTF-16 code units according to encoding, without a trailing terminator.
    fn unit_count(&self) -> Result<u64>;
    /// Copies the exact requested byte range; wrong encoding or invalid range changes no output.
    fn unix_bytes(&self, output: &mut [u8]) -> Result<()>;
    /// Copies the exact requested UTF-16 range; wrong encoding or invalid range changes no output.
    fn windows_units(&self, output: &mut [u16]) -> Result<()>;
    /// Returns human-readable UTF-8 which must never be used to reconstruct native selection.
    fn display(&self) -> Result<String>;
}

#[version(1)]
/// Synchronous input destination, implemented by the UI runtime or a concrete application adapter.
trait IInputSink {
    /// Copies one ordered event. Text requires complete UTF-8 at offset zero; every other event
    /// requires an empty text argument. The platform borrows this interface only during polling.
    fn input(&self, event: UiInput, text: &[u8]) -> Result<()>;
}

#[version(1)]
/// Outcome of removing one relevant OS transition from this window's queue.
    enum PollStatus: u8 {
        /// No relevant transition remains; update and render the accumulated input.
        IDLE = 0,
        /// Input was delivered or drawable/window state changed; poll again before rendering.
        EVENT = 1,
        /// Application quit or this native window's close was requested.
        CLOSE = 2,
    }

#[version(1)]
/// Committed native text-input placement, expressed in physical drawable pixels.
enum TextInputArea: u8 {
    /// No editable focus currently requests IME or text composition.
    None,
    /// Nonnegative editor rectangle; hosts convert this to logical OS/CSS coordinates.
    Area(Rect),
}

#[version(1)]
/// Native window, event pump and renderer share one COM identity and lifetime.
trait IPlatformWindow {
    /// Returns current drawable dimensions, including device scaling. Resize is synchronized
    /// by passing this value to the next UI update before rendering.
    fn size(&self) -> Result<Size>;
    /// Removes one relevant transition and borrows the destination for synchronous delivery.
    /// A failed delivery consumes the attempted event; later events remain queued. Recursive
    /// polling of this window returns BUSY. The destination is never retained by the platform.
    fn poll(&self, destination: &IInputSink) -> Result<PollStatus>;
    /// Enables/disables native text input and positions its composition UI after a UI update.
    /// Calling repeatedly with the same editable focus must preserve an active composition.
    fn text_input(&self, area: TextInputArea) -> Result<()>;
}

#[version(1)]
/// Constructible platform root whose native-window factory is its concrete class API.
factory Platform: IRenderDiagnostics {
    /// Creates an independent window and renderer; title is UTF-8 at offset zero.
    fn create_window(
        &self,
        title: &[u8],
        size: Size,
        assets: &IAssetBundle,
    ) -> Result<IPlatformWindow>;
}

#[version(1)]
/// Ordered draw record. Vertex ranges must partition the entire vertex buffer without gaps or overlap.
enum RenderBatch: u8 {
    /// Atlas-backed triangles already clipped and tessellated by the UI.
    Atlas {
        /// First vertex, equal to the end of the preceding vertex-bearing batch.
        first: u32,
        /// Positive vertex count divisible by three.
        count: u32,
    },
    /// Four clipped vertices in top-left, top-right, bottom-right, bottom-left order.
    Texture {
        /// First of exactly four vertices; stream.texture(batch_index) supplies the owned resource.
        first: u32,
    },
    /// Backend-specific work; stream.item(batch_index) supplies an owned capability from that renderer.
    Item {
        /// Positive, unclipped content rectangle in drawable pixels.
        rect: Rect,
        /// Positive intersection of content, widget clip and drawable viewport.
        clip: Rect,
    },
}

#[version(1)]
/// Immutable RGBA image whose final release destroys its native allocation with its owning device alive.
trait ITexture {
    /// Positive immutable pixel dimensions, independent of its destination rectangle.
    fn size(&self) -> Result<Size>;
}

#[version(1)]
/// Opaque owned application GPU work, authenticated by the renderer that created it.
/// Application-specific derived interfaces edit concrete scene data; this interface exposes no native handles.
trait IRenderItem {}

#[version(1)]
/// Optional renderer capability for immutable external images.
trait ITextureFactory {
    /// Uploads exactly width*height*4 RGBA bytes at offset zero, publishing only after a successful upload.
    fn create_texture(&self, size: Size, pixels: &[u8]) -> Result<ITexture>;
}

#[version(1)]
/// Owned diagnostic snapshots preserve backend details without exposing backend-dependent errors.
trait IRenderDiagnostics {
    /// Returns the most recent failed GPU operation's detail, or empty text before a failure.
    fn diagnostic(&self) -> Result<String>;
}

#[version(1)]
/// Finite floating-point position used by widget-local line and polygon drawing.
struct PaintPoint {
    /// Horizontal widget-local coordinate in pixels.
    x: f32,
    /// Vertical widget-local coordinate in pixels.
    y: f32,
}

#[version(1)]
/// Local solid vertex; applications never need the atlas's private white-pixel coordinates.
struct ColoredVertex {
    /// Horizontal widget-local position in pixels.
    x: f32,
    /// Vertical widget-local position in pixels.
    y: f32,
    /// Red in the least significant byte, then green, blue and alpha.
    rgba: u32,
}

#[version(1)]
/// Final textured vertex; tessellation and clipping already happened in the UI.
struct RenderVertex {
    /// Horizontal position in drawable pixels.
    x: f32,
    /// Vertical position in drawable pixels.
    y: f32,
    /// Normalized horizontal texture coordinate.
    u: f32,
    /// Normalized vertical texture coordinate.
    v: f32,
    /// Color packed as red in the least significant byte, then green, blue, alpha.
    rgba: u32,
}

#[version(1)]
/// Metadata for one synchronous renderer submission.
struct RenderInfo {
    /// Positive drawable dimensions.
    size: Size,
    /// Clear color in the same byte order as RenderVertex::rgba.
    clear: u32,
    /// Unique authority to read this frame's stream; expires when render returns.
    invocation: u64,
    /// Exact vertex count: atlas batches contain triples and texture batches contain four vertices.
    vertex_count: u32,
    /// Exact number of ordered batch records.
    batch_count: u32,
}

#[version(1)]
/// Owned reusable frame storage, readable only during its active submission.
trait IRenderStream {
    /// Copies a bounded range into caller-owned storage; offsets count vertices.
    fn vertices(&self, invocation: u64, output: &mut [RenderVertex]) -> Result<u32>;
    /// Copies ordered records; offsets count batches, and no output record contains a borrowed pointer.
    fn batches(&self, invocation: u64, output: &mut [RenderBatch]) -> Result<u32>;
    /// Retains the texture used by this batch; another batch kind or invalid index is rejected.
    fn texture(&self, invocation: u64, batch: u32) -> Result<ITexture>;
    /// Retains the custom item used by this batch; another batch kind or invalid index is rejected.
    fn item(&self, invocation: u64, batch: u32) -> Result<IRenderItem>;
}

#[version(1)]
/// GPU resources and presentation belong to this object's native window.
trait IRenderer {
    /// Imports and transactionally uploads a complete immutable atlas. Repeated preparation of
    /// the identical bundle is a cheap no-op; failure leaves the previous native atlas usable.
    fn prepare_assets(&self, assets: &IAssetBundle) -> Result<()>;
    /// Executes one complete frame synchronously; failure must not present it.
    fn render(&self, info: RenderInfo, assets: &IAssetBundle, stream: &IRenderStream) -> Result<()>;
}

#[version(1)]
/// Normalized source rectangle for one immutable texture; all edges lie in the unit square.
struct TextureRegion {
    /// Left source edge.
    u0: f32,
    /// Top source edge.
    v0: f32,
    /// Right source edge, no smaller than u0.
    u1: f32,
    /// Bottom source edge, no smaller than v0.
    v1: f32,
}

#[version(1)]
/// Common widget option bits; parent-child sizing rules belong to container edges.
struct WidgetOptions {
    /// Union of the documented option constants; unknown bits are rejected.
    bits: u32,
}

#[version(1)]
/// Semantic outer-frame role; concrete theme resources stay in the runtime.
    enum WidgetFrame: u8 {
        /// Generic appearance in the runtime theme.
        GENERIC = 0,
        /// Button appearance in the runtime theme.
        BUTTON = 1,
        /// Checkbox appearance in the runtime theme.
        CHECKBOX = 2,
        /// Text input appearance in the runtime theme.
        TEXT_INPUT = 3,
        /// Item appearance in the runtime theme.
        ITEM = 4,
        /// Combo appearance in the runtime theme.
        COMBO = 5,
        /// Slider track appearance in the runtime theme.
        SLIDER_TRACK = 6,
        /// Slider thumb appearance in the runtime theme.
        SLIDER_THUMB = 7,
        /// Scrollbar track appearance in the runtime theme.
        SCROLLBAR_TRACK = 8,
        /// Scrollbar thumb appearance in the runtime theme.
        SCROLLBAR_THUMB = 9,
        /// Close button appearance in the runtime theme.
        CLOSE_BUTTON = 10,
        /// Minimize button appearance in the runtime theme.
        MINIMIZE_BUTTON = 11,
        /// Maximize button appearance in the runtime theme.
        MAXIMIZE_BUTTON = 12,
        /// Restore button appearance in the runtime theme.
        RESTORE_BUTTON = 13,
        /// Resize grip appearance in the runtime theme.
        RESIZE_GRIP = 14,
        /// Window appearance in the runtime theme.
        WINDOW = 15,
        /// Panel appearance in the runtime theme.
        PANEL = 16,
    }

#[version(1)]
/// Current common widget policy, cached only within a synchronized runtime transaction.
struct WidgetProperties {
    /// Current frame and pointer-routing options.
    options: WidgetOptions,
    /// Keyboard capability bits matching the runtime's shared mapping: focus=1,
    /// Tab=2, Enter=4, Space=8, horizontal=16, vertical=32, hierarchy=64,
    /// popup=128, committed text=256.
    keyboard: u16,
    /// Semantic role used when FRAME is enabled.
    frame: WidgetFrame,
}

#[version(1)]
/// Copied, observational paint state; contains no borrowed runtime storage.
struct WidgetPaint {
    /// Content allocation in local coordinates, starting at zero.
    rect: Rect,
    /// Effective content-local clip.
    clip: Rect,
    /// Whether the containing surface permits interaction.
    enabled: bool,
    /// Pointer hover state for theme selection.
    hovered: bool,
    /// Keyboard focus state for theme selection.
    focused: bool,
    /// Current click transition for theme selection.
    clicked: bool,
    /// Active pointer interaction state.
    active: bool,
    /// Whether the logical window owns activation.
    window_active: bool,
}

#[version(1)]
/// Non-reused authority for one synchronous container measurement or placement.
struct LayoutScope {
    /// Zero is never active; retaining a service does not extend this invocation.
    invocation: u64,
}

#[version(1)]
/// Parent-authored participation, independent of a child's semantic options.
    enum LayoutParticipation: u8 {
        /// Update, paint and input are enabled.
        ACTIVE = 0,
        /// Update and paint remain enabled; the entire subtree rejects input.
        DISABLED = 1,
        /// Ownership remains; ordinary update, paint and input skip this subtree.
        HIDDEN = 2,
    }

#[version(1)]
/// Complete copied parent layout output, published only after a successful placement.
struct ContainerGeometry {
    /// Logical extent visible to the parent's overflow policy.
    content: Size,
    /// Descendant viewport in the container's local coordinates, clipped to its content by runtime.
    viewport: Rect,
    /// Horizontal descendant translation in the container's local coordinates.
    offset_x: i32,
    /// Vertical descendant translation in the container's local coordinates.
    offset_y: i32,
    /// Whether visible descendant overflow contributes to this container's extent.
    propagate_overflow: bool,
}

#[version(1)]
/// Owned scoped child geometry service; no borrowed runtime node crosses COM.
/// Measurement permits only count and measure. Placement permits every method.
/// Calls reject expired/parent tokens and direct reentry while a child is active.
trait ILayoutService {
    /// Returns the direct child count for this exact active invocation.
    fn child_count(&self, scope: LayoutScope) -> Result<u32>;
    /// Measures a child's outer preference, including its own frame geometry.
    fn measure_child(&self, scope: LayoutScope, index: u32, limits: LayoutLimits) -> Result<Size>;
    /// Assigns one exact parent-content rectangle; runtime never reinterprets sizing policy.
    fn place_child(&self, scope: LayoutScope, index: u32, rect: Rect) -> Result<Size>;
    /// Reads the content extent produced by the child's most recent placement.
    fn child_content_size(&self, scope: LayoutScope, index: u32) -> Result<Size>;
    /// Sets one child's derived participation, including its entire subtree.
    fn set_participation(&self, scope: LayoutScope, index: u32, participation: LayoutParticipation) -> Result<()>;
    /// Invalidates placement when a shared dependency changes despite an unchanged assigned rectangle.
    fn child_placement_changed(&self, scope: LayoutScope, index: u32) -> Result<()>;
}

#[version(1)]
/// Container policy beside IWidget on the same object; mutually exclusive with ILeafLayout.
trait IContainerLayout {
    /// Returns this container's immutable, host-issued collection identity for its entire lifetime.
    /// The implementation retains its matching editor privately and publishes metadata after every committed edit.
    fn children(&self) -> Result<IChildren>;
    /// Measures content through indexed scoped access; semantic and topology mutations are forbidden.
    fn measure(&mut self, scope: LayoutScope, bounds: LayoutLimits, layout: &ILayoutService) -> Result<Size>;
    /// Places direct children and returns complete copied viewport/content policy.
    fn place(&mut self, scope: LayoutScope, rect: Rect, layout: &ILayoutService) -> Result<ContainerGeometry>;
    /// Filters a router-selected event; false permits ancestor bubbling without exposing covered siblings.
    /// The runtime bypasses this filter for captured drag/release continuation.
    fn accepts_event(&self, event: WidgetEvent, text: &[u8]) -> Result<bool>;
}

#[version(1)]
/// Private topology authority retained by a container implementation.
/// Its read-only view is a distinct COM identity: querying that view cannot
/// bypass a concrete container's matching Linear/Grid/domain edge metadata.
trait IChildrenEditor {
    /// Returns the read-only capability used by the runtime's authoritative traversal.
    fn view(&self) -> Result<IChildren>;
    /// Inserts one unmounted child at index (including count), committing only after validation.
    fn insert(&self, index: u32, widget: &IWidget) -> Result<ChildEditResult>;
    /// Validates the replacement before permanently closing the old indexed subtree.
    fn replace(&self, index: u32, widget: &IWidget) -> Result<ChildEditResult>;
    /// Permanently closes one indexed subtree; it cannot be detached or reparented.
    fn remove(&self, index: u32) -> Result<ChildEditResult>;
    /// Permanently closes all children while leaving this collection open for new content.
    fn clear(&self) -> Result<ChildEditResult>;
    /// Permanently closes the collection and its descendants, including retained read-only views.
    fn close(&self) -> Result<ChildEditResult>;
}

#[version(1)]
/// Successful topology commit, including a separately reported teardown result.
/// An editor method's Err means no edit committed. Ok means the container must
/// publish matching edge metadata before propagating this teardown status.
struct ChildEditResult {
    /// Error from closing a replaced/removed subtree, or NC_OK after clean teardown.
    teardown: Status,
}

#[version(1)]
/// One parent-owned track; variants carry only the data relevant to their policy.
enum LayoutTrack: u8 {
    /// Uses the child's intrinsic preferred extent.
    Content,
    /// Uses an exact nonnegative pixel extent.
    Fixed {
        /// Exact nonnegative pixel extent.
        extent: i32,
    },
    /// Receives a strictly positive finite weighted share of bounded remaining space.
    Flex {
        /// Strictly positive finite share of bounded remaining space.
        weight: f32,
    },
}

#[version(1)]
/// Shared cross-axis size of a linear container's line.
enum CrossSize: u8 {
    /// Fits the largest child's preferred cross extent.
    Content,
    /// Reports preferred content, then stretches to its exact placement allocation.
    Stretch,
    /// Uses an exact nonnegative pixel extent.
    Fixed {
        /// Exact nonnegative pixel extent.
        extent: i32,
    },
}

#[version(1)]
/// Optional exact child cross extent; Stretch uses the owning linear line's cross size.
enum ChildCrossSize: u8 {
    /// Uses the line's resolved cross extent.
    Stretch,
    /// Uses an exact nonnegative pixel extent.
    Fixed {
        /// Exact nonnegative pixel extent.
        extent: i32,
    },
}

#[version(1)]
/// Main axis and leading edge, without independent potentially inconsistent flags.
    enum FlowDirection: u8 {
        /// Horizontal sequence starting at the left edge.
        LEFT_TO_RIGHT = 0,
        /// Horizontal sequence starting at the right edge.
        RIGHT_TO_LEFT = 1,
        /// Vertical sequence starting at the top edge.
        TOP_TO_BOTTOM = 2,
        /// Vertical sequence starting at the bottom edge.
        BOTTOM_TO_TOP = 3,
    }

#[version(1)]
/// Linear-owned relationship stored beside one direct child.
struct LinearEdge {
    /// Main-axis content, exact or weighted-flexible policy.
    main: LayoutTrack,
    /// Optional exact cross extent for this child only.
    cross: ChildCrossSize,
}

#[version(1)]
/// Positive Grid-owned cell span; placement clamps columns at the right grid boundary.
struct GridExtent {
    /// Number of logical columns, greater than zero.
    columns: u32,
    /// Number of logical rows, greater than zero.
    rows: u32,
}

#[version(1)]
/// Common editing capability inherited by built-in concrete container interfaces.
trait IContainer: IWidget {
    /// Returns the stable read-only view; editing stays on the concrete container to preserve edge metadata.
    fn children(&self) -> Result<IChildren>;
    /// Removes one complete subtree and matching edge metadata; Ok reports a committed edit.
    fn remove(&mut self, index: u32) -> Result<ChildEditResult>;
    /// Removes all owned subtrees and their matching metadata while retaining reusable capacity.
    fn clear(&mut self) -> Result<ChildEditResult>;
}

#[version(1)]
/// Constructible directional container whose concrete editing API is one class contract.
class Linear: IWidget + IContainerLayout {
    /// Returns the stable read-only topology view for this container's lifetime.
    fn children(&self) -> Result<IChildren>;
    /// Removes one complete subtree and matching edge metadata.
    fn remove(&mut self, index: u32) -> Result<ChildEditResult>;
    /// Removes all owned subtrees and matching metadata while retaining reusable capacity.
    fn clear(&mut self) -> Result<ChildEditResult>;
    /// Returns its complete axis and leading-edge policy.
    fn direction(&self) -> Result<FlowDirection>;
    /// Replaces the direction without reordering child ownership.
    fn set_direction(&mut self, direction: FlowDirection) -> Result<()>;
    /// Returns the shared cross-axis size policy.
    fn cross_size(&self) -> Result<CrossSize>;
    /// Validates and replaces the shared cross-axis policy.
    fn set_cross_size(&mut self, cross: CrossSize) -> Result<()>;
    /// Returns one child's exact parent-owned sizing relationship.
    fn edge(&self, index: u32) -> Result<LinearEdge>;
    /// Replaces sizing metadata without replacing the child's identity.
    fn set_edge(&mut self, index: u32, edge: LinearEdge) -> Result<()>;
    /// Validates child and relationship before committing insertion at index, including count.
    fn insert(&mut self, index: u32, child: &IWidget, edge: LinearEdge) -> Result<ChildEditResult>;
    /// Validates replacement before permanently closing the previous indexed subtree.
    fn replace(&mut self, index: u32, child: &IWidget, edge: LinearEdge) -> Result<ChildEditResult>;
}

#[version(1)]
/// Constructible Grid whose topology, spans, and both track axes share one class contract.
class Grid: IWidget + IContainerLayout {
    /// Returns the stable read-only topology view for this container's lifetime.
    fn children(&self) -> Result<IChildren>;
    /// Removes one complete subtree and matching span metadata.
    fn remove(&mut self, index: u32) -> Result<ChildEditResult>;
    /// Removes all owned subtrees and matching metadata while retaining reusable capacity.
    fn clear(&mut self) -> Result<ChildEditResult>;
    /// Copies a range of column policies; offset indexes tracks and the return value is total count.
    fn columns(&self, output: &mut [LayoutTrack]) -> Result<u32>;
    /// Replaces the complete column sequence after validating every track; input offset must be zero.
    fn set_columns(&mut self, tracks: &[LayoutTrack]) -> Result<()>;
    /// Copies a range of row policies; offset indexes tracks and the return value is total count.
    fn rows(&self, output: &mut [LayoutTrack]) -> Result<u32>;
    /// Replaces the complete row sequence after validating every track; input offset must be zero.
    fn set_rows(&mut self, tracks: &[LayoutTrack]) -> Result<()>;
    /// Returns one child's positive Grid-owned span.
    fn edge(&self, index: u32) -> Result<GridExtent>;
    /// Changes span without replacing the child's identity.
    fn set_edge(&mut self, index: u32, edge: GridExtent) -> Result<()>;
    /// Validates a positive span and unmounted child before committing insertion.
    fn insert(&mut self, index: u32, child: &IWidget, edge: GridExtent) -> Result<ChildEditResult>;
    /// Validates replacement before permanently closing the previous indexed subtree.
    fn replace(&mut self, index: u32, child: &IWidget, edge: GridExtent) -> Result<ChildEditResult>;
}

#[version(1)]
/// Coherent scrolling observation; requested offsets are clamped against new content during placement.
struct ScrollInfo {
    /// Actual nonnegative offset requests shared with the scrollbar widgets.
    requested: Point,
    /// Maximum offsets for the most recently installed scrollbar ranges.
    maximum: Point,
    /// Most recently committed content viewport, excluding padding and visible bars.
    viewport: Size,
    /// Whether wheel input and responsive scrollbar participation are enabled.
    enabled: bool,
}

#[version(1)]
/// Shared scroll policy; this capability cannot replace the fixed content of a composed editor.
trait IScrolling: IWidget {
    /// Returns one coherent request/range/viewport observation without a parent-widget backpointer.
    fn info(&self) -> Result<ScrollInfo>;
    /// Requests nonnegative offsets; next placement clamps against freshly measured content.
    fn set_offset(&mut self, offset: Point) -> Result<()>;
    /// Enables or disables wheel input and both structural scrollbar children.
    fn set_enabled(&mut self, enabled: bool) -> Result<()>;
    /// Requests the next measured vertical end while preserving the horizontal request.
    fn scroll_to_end(&mut self) -> Result<()>;
    /// Requests the nearest offsets that reveal a nonnegative content-local rectangle.
    fn reveal(&mut self, rect: Rect) -> Result<()>;
}

#[version(1)]
/// Constructible scroll composite with one replaceable content root and private structural roles.
class ScrollArea: IWidget + IContainerLayout + IScrolling {
    /// Returns the actual application content widget, without its surrounding transform surface.
    fn content(&self) -> Result<IWidget>;
    /// Validates replacement before closing old content; structural roles and model identity stay fixed.
    fn replace_content(&mut self, content: &IWidget) -> Result<ChildEditResult>;
}

#[version(1)]
/// Immutable disclosure presentation; expansion and child ownership use one shared policy.
