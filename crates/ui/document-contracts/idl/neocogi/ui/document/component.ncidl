extern neocogi.com.events;
use neocogi.com.events::IEventReceiver;
extern neocogi.ui.core;
extern neocogi.ui.nodes;
use neocogi.ui.nodes::UiFactory;
use neocogi.ui.core::{IWidget, IWidgetHost};

#[version(2)]
/// A compiled component exposes its root and typed widget lookup.
/// Getters and setters belong to the returned widget interfaces; event receivers
/// are supplied to factories during construction, never discovered as commands.
interface IUiComponent {
    /// Observes the real root without retaining ownership; mounting uses a separate owner transfer.
    fn root(&self) -> Result<WeakComBox<IWidget>>;
    /// Resolves one authored widget by its stable node key for a checked concrete interface query.
    fn widget(&self, name: &[u8]) -> Result<WeakComBox<IWidget>>;
}

#[version(2)]
/// Optional COM capability queried from an activated plugin root factory.
/// It lets an independent designer enumerate constructible widgets without
/// linking the plugin's Rust contract or implementation crate.
interface IDesignWidgetCatalog {
    /// Number of widget kinds exposed by this one plugin factory.
    fn widget_count(&self) -> Result<u32>;
    /// Copies one versioned authoring descriptor into an initialized byte buffer.
    /// The return value is the required byte count; a short buffer is unchanged.
    fn describe(&self, index: u32, output: &mut [u8]) -> Result<u32>;
    /// Constructs a widget from bounded provider-owned NCB settings. The provider
    /// validates its private schema/revision and receiver before allocating a widget.
    /// Settings and editor snapshots share the 64 KiB ui-design NCB policy.
    fn create_widget(&self, index: u32, host: &IWidgetHost, settings: &[u8], events: &WidgetEventBinding) -> Result<ComBox<IWidget>>;
    /// Opens a fresh draft using the editor runtime's ordinary control factory.
    /// Return NOINTERFACE only when this kind deliberately has no settings editor.
    /// Other failures leave the host's accepted document and preview unchanged.
    fn create_editor(&self, index: u32, widgets: &UiFactory, settings: &[u8]) -> Result<ComBox<IDesignSettingsEditor>>;
}

#[version(1)]
/// Optional authoring session owned by the designer, separate from runtime widgets.
/// The plugin owns typed draft validation; the host never invokes reflected setters.
interface IDesignSettingsEditor {
    /// Transfers the draft control tree exactly once; repeated calls return NOT_FOUND.
    /// The receiving inspector owns its controls; this session holds only weak handles.
    /// Dropping/replacing the inspector revokes those handles immediately.
    fn take_view(&mut self) -> Result<ComBox<IWidget>>;
    /// Validates the complete current draft and copies its NCB snapshot.
    /// Return the required byte count; short output stays unchanged. Offset must be
    /// zero. Reads must be stable while the host performs length and copy calls
    /// without dispatching more UI input. No accepted runtime widget is modified.
    fn settings(&self, output: &mut [u8]) -> Result<u32>;
}

#[version(2)]
/// Constructor-only receiver transport for a heterogeneous custom-widget catalog.
/// Observed carries a COM capability, never an untyped event payload. The selected
/// factory receives the common IEventReceiver before publishing the widget.
enum WidgetEventBinding {
    /// Permanently suppress delivery for this instance, including designer previews.
    Unobserved,
    /// Application receiver whose required typed interface is checked by the factory.
    Observed(ComPtr<IEventReceiver>),
}

#[version(1)]
/// Optional atomic metadata publication for a constructed component's authored snapshot.
/// Live widget construction, bindings and resources remain under normal reload ownership.
interface IUiComponentMetadata {
    /// Accepts a complete bounded component recipe only when schema and root constructor tree
    /// exactly match the current authored snapshot. Only name/output display aliases can change.
    /// Validate before publication; failure preserves source and all live widgets. No generation
    /// changes and no setters rewrite interactive state. Offset must be zero; layout/paint reject.
    fn replace_metadata(&mut self, document: &[u8]) -> Result<()>;
}
