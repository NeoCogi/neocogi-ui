#[version(1)]
/// Constructible optional external theme compiler producing ordinary immutable bundles.
factory ThemeLoader: ISkinDiagnostics {
    /// Resolves a native theme path against the base catalog while preserving resource names.
    fn load_theme(&self, path: &INativePath, base: &IAssetBundle) -> Result<ComPtr<IAssetBundle>>;
}

#[version(1)]
/// Explicit choice between preserving authored artwork and replacing it with a flat recipe.
enum PaletteEdit: u8 {
    /// Keeps current role/state visuals, including image-backed theme artwork.
    Preserve,
    /// Compiles this complete named palette through the shared flat-style rules.
    Flat(FlatPalette),
}

#[version(1)]
/// Constructible appearance compiler independent of UI trees and renderer resources.
factory StyleCompiler: ISkinDiagnostics {
    /// Derives a complete immutable revision in the base catalog without installing it.
    /// Preserve retains artwork; Flat recompiles every appearance from one concrete palette.
    fn derive_style(&self, base: &IAssetBundle, metrics: AssetMetrics, palette: PaletteEdit) -> Result<ComPtr<IAssetBundle>>;
}
