use neocogi.renderer::{IRenderOutcome, IRenderSurface, IRenderHost, IRenderViewBlock, IRenderer, ITexture, Rect, Size, TextureRegion};

#[version(1)]
/// GFX textured UI vertex before private clipping and generic-command lowering.
struct RenderVertex {
    /// Horizontal position in drawable pixels.
    x: f32,
    /// Vertical position in drawable pixels.
    y: f32,
    /// Normalized horizontal texture coordinate.
    u: f32,
    /// Normalized vertical texture coordinate.
    v: f32,
    /// Color packed as red in the least significant byte, then green, blue, and alpha.
    rgba: u32,
}

#[version(1)]
/// One solid-color vertex in final drawable coordinates before rectangular clipping.
struct SolidVertex {
    /// Finite horizontal position in drawable pixels.
    x: f32,
    /// Finite vertical position in drawable pixels.
    y: f32,
    /// Color packed as red in the least significant byte, then green, blue, and alpha.
    rgba: u32,
}

#[version(1)]
/// Finite drawable position used as the origin of one UTF-8 text run.
struct DrawPoint {
    /// Horizontal drawable coordinate in pixels.
    x: i32,
    /// Vertical drawable coordinate in pixels.
    y: i32,
}

#[version(1)]
/// Complete renderer-neutral payload for one three-by-three patch draw.
///
/// The operation reuses the closed asset-patch vocabulary so UI and GFX cannot
/// disagree about flat-cell order or image-source meaning. Destination geometry,
/// source slicing, empty-cell removal, clipping, and batching remain private to
/// the receiving compositor.
struct NinePatchDraw {
    /// Nonnegative destination borders; opposing sides shrink proportionally when they do not fit.
    insets: Insets,
    /// Whether the stretchable center cell contributes geometry, zero or one.
    center_visible: u8,
    /// Nine flat colors or one bundle-local image and its source-space insets.
    patch: AssetPatch,
}

#[version(1)]
/// Renderer-neutral display-list executor owned by the GFX plugin.
///
/// UI code supplies semantic operations in painter order. The compositor owns
/// atlas lookup, glyph expansion, rectangular clipping, final vertex batching,
/// and the single synchronous renderer submission. No backend-native handle or
/// Rust implementation type crosses this boundary.
///
/// One compositor is one mutable resource and frame session. Cloning its COM reference
/// aliases that session; it does not create independent state. Share GfxPluginFactory
/// to create separate sessions. UI runtimes keep their compositor capability private.
///
/// Within an active frame, a failed draw preserves complete vertex/batch coverage
/// and keeps that frame active.
/// Earlier complete primitives may remain, including a prefix of a multi-primitive draw;
/// the caller may continue or submit them, or cancel. Attempted draws keep their budget
/// charges. begin requires the previous frame to end through submit or cancel.
interface GfxCompositor: IGfxDiagnostics {
    /// Bind private graphics authority and prepare the current atlas before replacing this session.
    /// Color/resource writes and image import are enabled; all depth and clear permissions are denied.
    /// The host and factories remain private. The report owns this operation's original status/text.
    fn bind_render_host_result(&mut self, host: &IRenderHost, surface: &IRenderSurface) -> Result<ComPtr<IRenderOutcome>>;
    /// Takes a sealed generic graphics contribution at its reserved painter-order position.
    /// The renderer authenticates its private provenance before acquiring the native frame.
    fn render_view(&mut self, block: ComBox<IRenderViewBlock>) -> Result<()>;
    /// Imports a complete compatible resource revision before the UI publishes matching style state.
    fn install_assets_result(&mut self, assets: &IAssetBundle) -> Result<ComPtr<IRenderOutcome>>;
    /// Clears retained command output and starts one frame with positive drawable dimensions.
    fn begin(&mut self, size: Size, clear: u32) -> Result<()>;
    /// Appends complete solid triangles with one authoritative drawable clip.
    fn solid_triangles(&mut self, clip: Rect, vertices: &[SolidVertex]) -> Result<()>;
    /// Appends complete atlas triangles whose UV coordinates are already normalized.
    fn atlas_triangles(&mut self, clip: Rect, vertices: &[RenderVertex]) -> Result<()>;
    /// Expands one typed patch atomically. Oversized nonnegative image source slices shrink
    /// and receive a pink 0.5-opacity overlay; destination-only shrinking remains untinted.
    fn nine_patch(&mut self, clip: Rect, destination: Rect, draw: NinePatchDraw) -> Result<()>;
    /// Expands one UTF-8 run through a bundle-local font slot and appends its visible glyphs.
    fn text(&mut self, clip: Rect, font: u32, origin: DrawPoint, rgba: u32, text: &[u8]) -> Result<()>;
    /// Centers one bundle-local icon slot inside a destination and appends its visible quad.
    fn icon(&mut self, clip: Rect, icon: u32, destination: Rect, rgba: u32) -> Result<()>;
    /// Retains and appends one renderer-owned texture with normalized source coordinates.
    /// CPU reservation failure appends neither its quad nor its batch and retains no additional texture owner.
    fn texture(&mut self, clip: Rect, destination: Rect, source: TextureRegion, rgba: u32, texture: &ITexture) -> Result<()>;
    /// Submits the complete frame once and clears retained resource capabilities on every result.
    /// The report retains the original lowering/native failure after device and frame cleanup.
    fn submit_result(&mut self, renderer: &IRenderer) -> Result<ComPtr<IRenderOutcome>>;
    /// Abandons an incomplete frame while retaining reusable allocations.
    fn cancel(&mut self) -> Result<()>;
}
